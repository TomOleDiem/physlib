module

public import Physlib.CondensedMatter.Crystal.Symmetry.AffineIsometries
public import Mathlib.Algebra.Module.BigOperators

/-!
# Symmorphic groups

A group of affine isometries is symmorphic if its point operations can all be taken about one
common origin.

## i. Overview

Not every crystal has its rotations and reflections as symmetries about a single point. In the
square lattice with an atom at each site, all quarter turns and mirrors fix an atom, and the space
group is generated by the lattice translations and these point operations. Such groups are called
symmorphic. In a crystal with a glide, a mirror is a symmetry only after composing it with a
translation by half a lattice vector, and no choice of origin makes it a symmetry by itself. Such
groups are non-symmorphic.

For a group of affine isometries, the translations form a normal subgroup with the point group as
quotient, and the group is symmorphic if this extension splits. It is then a semidirect product of
the point group acting on the translations. A finite group of affine isometries fixes a point, the
centroid of an orbit, which gives the criterion proved here: a group with finite point group is
symmorphic exactly when its point operations are realised by elements fixing one common point.

## ii. Key results

- `Crystal.Euclidean.IsSymmorphic` : the extension of the point group by the translations splits.
- `Crystal.Euclidean.exists_semidirect_mulEquiv` : a symmorphic group is a semidirect product of
  its point group acting on its translations.
- `Crystal.Euclidean.fixing` : the affine isometries that fix a point.
- `Crystal.Euclidean.exists_fixed_point` : a finite group of affine isometries fixes a point.
- `Crystal.Euclidean.isSymmorphic_iff_exists_map_fixing` : a group with finite point group is
  symmorphic exactly when the elements fixing some point realise all its point operations.

## iii. Table of contents

- A. Symmorphic groups
- B. Isometries fixing a point
- C. A finite group fixes a point
- D. The common fixed point criterion

## iv. References

* N. Ashcroft & N. D. Mermin, Solid State Physics, Chapter 7.

-/

@[expose] public section

namespace Physlib.CondensedMatter.Crystal

namespace Euclidean

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {S : Subgroup (E ≃ᵃⁱ[ℝ] E)} {p : E}

/-! ## A. Symmorphic groups -/

/-- A group of affine isometries is symmorphic if its extension by the translations splits. -/
def IsSymmorphic (S : Subgroup (E ≃ᵃⁱ[ℝ] E)) : Prop := Nonempty (extension S).Splitting

/-- **A symmorphic group is a semidirect product of its point group acting on its
translations.** -/
lemma exists_semidirect_mulEquiv (h : IsSymmorphic S) :
    ∃ φ : S.map linearHom →* MulAut (translations S),
      Nonempty (translations S ⋊[φ] S.map linearHom ≃* S) := by
  obtain ⟨sp⟩ := h
  exact ⟨_, ⟨sp.semidirectProductMulEquiv⟩⟩

/-! ## B. Isometries fixing a point -/

/-- The affine isometries that fix a point. -/
def fixing (x : E) : Subgroup (E ≃ᵃⁱ[ℝ] E) where
  carrier := {ψ | ψ x = x}
  one_mem' := rfl
  mul_mem' {ψ χ} hψ hχ := by
    show ψ (χ x) = x
    rw [hχ, hψ]
  inv_mem' {ψ} hψ := by
    show ψ.symm x = x
    rw [ψ.symm_apply_eq, hψ]

/-- A group of affine isometries that fix a point maps injectively to the linear isometries. -/
lemma injective_linearHom_of_le_fixing {H : Subgroup (E ≃ᵃⁱ[ℝ] E)} (hH : H ≤ fixing p) :
    Function.Injective (linearHom.domRestrict H) := by
  intro ψ χ h
  ext x
  have h1 := ψ.1.map_vsub x p
  have h2 := χ.1.map_vsub x p
  rw [vsub_eq_sub, vsub_eq_sub, (hH ψ.2 : ψ.1 p = p)] at h1
  rw [vsub_eq_sub, vsub_eq_sub, (hH χ.2 : χ.1 p = p)] at h2
  exact sub_left_injective (h1.symm.trans ((DFunLike.congr_fun h _).trans h2))

/-! ## C. A finite group fixes a point -/

/-- An affine isometry preserves combinations of points with weights summing to one. -/
lemma map_sum_smul {ι : Type*} (s : Finset ι) {w : ι → ℝ} (hw : ∑ i ∈ s, w i = 1) (x : ι → E)
    (ψ : E ≃ᵃⁱ[ℝ] E) : ψ (∑ i ∈ s, w i • x i) = ∑ i ∈ s, w i • ψ (x i) := by
  have h (y : E) : ψ y = ψ.linearIsometryEquiv y + ψ 0 := by
    rw [linearIsometryEquiv_apply]
    abel
  rw [h, map_sum]
  simp only [map_smul, h (x _), smul_add, Finset.sum_add_distrib, ← Finset.sum_smul, hw, one_smul]

/-- **A finite group of affine isometries fixes a point**, the centre of the orbit of the
origin. -/
lemma exists_fixed_point {G : Type*} [Group G] [Finite G] (s : G →* E ≃ᵃⁱ[ℝ] E) :
    ∃ p, ∀ g, s g p = p := by
  have := Fintype.ofFinite G
  refine ⟨∑ h, (Fintype.card G : ℝ)⁻¹ • s h 0, ?_⟩
  intro g
  rw [map_sum_smul _ (by simp [Finset.sum_const, Fintype.card_ne_zero]) _ (s g)]
  refine Fintype.sum_equiv (Equiv.mulLeft g) _ _ ?_
  intro h
  rw [Equiv.coe_mulLeft, map_mul]
  rfl

/-! ## D. The common fixed point criterion -/

/-- The inverse of the linear part on the elements of `S` fixing a point. -/
noncomputable def mulEquivFixing (h : (S ⊓ fixing p).map linearHom = S.map linearHom) :
    S.map linearHom ≃* ↥(S ⊓ fixing p) :=
  (MulEquiv.subgroupCongr ((MonoidHom.domRestrict_range _ _).trans h).symm).trans
    (MonoidHom.ofInjective (injective_linearHom_of_le_fixing inf_le_right)).symm

/-- A section of the linear part, given by the elements of `S` fixing a point. -/
noncomputable def sectionOfFixing (h : (S ⊓ fixing p).map linearHom = S.map linearHom) :
    S.map linearHom →* S :=
  (Subgroup.inclusion inf_le_left).comp (mulEquivFixing h).toMonoidHom

/-- The section has the right linear part. -/
lemma linearHom_sectionOfFixing (h : (S ⊓ fixing p).map linearHom = S.map linearHom)
    (g : S.map linearHom) : linearHom (sectionOfFixing h g : E ≃ᵃⁱ[ℝ] E) = g :=
  MonoidHom.apply_ofInjective_symm (injective_linearHom_of_le_fixing inf_le_right)
    (MulEquiv.subgroupCongr ((MonoidHom.domRestrict_range _ _).trans h).symm g)

/-- If the point operations are realised by elements fixing a point, the group is symmorphic. -/
lemma isSymmorphic_of_map_fixing (h : (S ⊓ fixing p).map linearHom = S.map linearHom) :
    IsSymmorphic S := by
  refine ⟨⟨sectionOfFixing h, ?_⟩⟩
  intro g
  exact Subtype.ext (linearHom_sectionOfFixing h g)

/-- A splitting of the extension gives an origin about which all point operations are
symmetries. -/
lemma exists_map_fixing [Finite (S.map linearHom)] (h : IsSymmorphic S) :
    ∃ p, (S ⊓ fixing p).map linearHom = S.map linearHom := by
  obtain ⟨sp⟩ := h
  obtain ⟨p, hp⟩ := exists_fixed_point (S.subtype.comp sp.toMonoidHom)
  refine ⟨p, le_antisymm (Subgroup.map_mono inf_le_left) ?_⟩
  intro g hg
  refine Subgroup.mem_map.2 ⟨sp ⟨g, hg⟩, ⟨(sp _).2, hp _⟩, ?_⟩
  exact congrArg Subtype.val (sp.rightHom_splitting ⟨g, hg⟩)

/-- **A group of affine isometries with finite point group is symmorphic exactly when the elements
fixing some point realise all its point operations.** -/
lemma isSymmorphic_iff_exists_map_fixing [Finite (S.map linearHom)] :
    IsSymmorphic S ↔ ∃ p, (S ⊓ fixing p).map linearHom = S.map linearHom := by
  constructor
  · exact exists_map_fixing
  · rintro ⟨_, h⟩
    exact isSymmorphic_of_map_fixing h

end Euclidean

end Physlib.CondensedMatter.Crystal
