module

public import PhyslibAlpha.QuantumMechanics.InfiniteBosons.FieldTermSelfAdjoint
public import PhyslibAlpha.ProbabilisticTheory.HilbertSpace.Unbounded.CayleySpectralData.SpecTheorem
public import PhyslibAlpha.ProbabilisticTheory.HilbertSpace.Unbounded.Flow.Stone
/-!

# The Weyl operators of one mode as a unitary group

The single-mode field operator generates a strongly continuous unitary group.

## i. Overview

The field operator `φ_x = c₀ a_x + c̄₀ a_x†` is essentially self-adjoint on the algebraic Fock space
of an arbitrary lattice (`FieldTermSelfAdjoint.lean`). The unbounded spectral theorem of
`PhyslibAlpha.ProbabilisticTheory.HilbertSpace.Unbounded` gives the spectral measure of its closure and
the strongly continuous unitary group `exp(i t φ_x)`. This is the Weyl operator `W(t f)` of the
phase space vector `f` with the single-mode field operator `φ_x`. The group law and the
continuity follow from the spectral construction. The orbit of an algebraic vector has the
derivative `i φ_x f`, so `φ_x` is the generator. The unitary group lies in the bounded operators of
the Fock Hilbert space. The Weyl relations between different phase space vectors are the next
statement.

## ii. Key results

- `InfiniteBosons.fieldSpectral`: the spectral theorem for the closure of `φ_x`.
- `InfiniteBosons.weylGroup`: the unitary group `exp(i t φ_x)`.
- `InfiniteBosons.weylGroup_add`, `InfiniteBosons.weylGroup_continuous`,
  `InfiniteBosons.weylGroup_unitary`: group law, strong continuity and unitarity.
- `InfiniteBosons.weylGroup_hasDerivAt`: the generator on algebraic vectors.

## iii. Table of contents

- A. The unitary group
- B. The generator

## iv. References

* M. Reed, B. Simon, Methods of Modern Mathematical Physics I, Section VIII.4.
-/

@[expose] public section

open Finsupp

noncomputable section

namespace InfiniteBosons

open ProbabilisticTheory ProbabilisticTheory.QuantumMechanics
variable {L : Type*} [DecidableEq L]

set_option linter.defProp false in
/-- **The spectral theorem for the single-mode field operator.** -/
def fieldSpectral (x : L) {c0 : ℂ} (hc0 : c0 ≠ 0) :=
  unboundedSpectralTheorem_of_essentiallySelfAdjoint (polyOp (fieldTerm x c0))
    (fieldTerm_isEssentiallySelfAdjoint x hc0)

/-- **The Weyl operators of one mode**: `exp(i t φ_x)` with `φ_x = c₀ a_x + c̄₀ a_x†`, the unitary
group of the self-adjoint closure. -/
def weylGroup (x : L) {c0 : ℂ} (hc0 : c0 ≠ 0) :=
  (fieldSpectral x hc0).expUnitaryGroup


lemma weylGroup_zero (x : L) {c0 : ℂ} (hc0 : c0 ≠ 0) : weylGroup x hc0 0 = 1 :=
  (fieldSpectral x hc0).expUnitaryGroup_zero

lemma weylGroup_add (x : L) {c0 : ℂ} (hc0 : c0 ≠ 0) (t s : ℝ) :
    weylGroup x hc0 (t + s) = weylGroup x hc0 t * weylGroup x hc0 s :=
  (fieldSpectral x hc0).expUnitaryGroup_add t s

lemma weylGroup_continuous (x : L) {c0 : ℂ} (hc0 : c0 ≠ 0) (v : HilbertSp (Occ L)) :
    Continuous fun t : ℝ => weylGroup x hc0 t v :=
  (fieldSpectral x hc0).expUnitaryGroup_continuous_apply v

lemma weylGroup_unitary (x : L) {c0 : ℂ} (hc0 : c0 ≠ 0) (t : ℝ) :
    weylGroup x hc0 t ∈ unitary (HilbertSp (Occ L) →WOT[ℂ] HilbertSp (Occ L)) :=
  (weylGroup x hc0).mem_unitary t

/-- **The orbit of an algebraic vector has derivative `i φ_x f`**: the group is generated by the
field operator. -/
theorem weylGroup_hasDerivAt (x : L) {c0 : ℂ} (hc0 : c0 ≠ 0) (f : Occ L →₀ ℂ) :
    HasDerivAt (fun t : ℝ => weylGroup x hc0 t (embed f))
      (Complex.I • embed ((fieldTerm x c0).1.1 f)) 0 := by
  have hle := (polyOp (fieldTerm x c0)).le_closure
  have hmem : embed f ∈ (polyOp (fieldTerm x c0)).closure.domain :=
    hle.1 (LinearMap.mem_range_self embed f)
  have h := (fieldSpectral x hc0).expUnitaryGroup_hasDerivAt_zero ⟨embed f, hmem⟩
  have hval : (polyOp (fieldTerm x c0)).closure ⟨embed f, hmem⟩ =
      embed ((fieldTerm x c0).1.1 f) := by
    rw [← polyOp_embed (fieldTerm x c0) f]
    exact (hle.2 (x := ⟨embed f, LinearMap.mem_range_self embed f⟩)
      (y := ⟨embed f, hmem⟩) rfl).symm
  rw [hval] at h
  exact h

end InfiniteBosons
