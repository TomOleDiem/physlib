# Local algebras of lattice systems and their derivations

Polynomials in site-local generators, their finite support and locality, and the Heisenberg
derivation of a locally finite family of local terms.

## i. Overview

A star algebra `A` is a local algebra over a set `L` of sites when every site carries a star-closed
family of generators and generators at different sites commute. The polynomials of a region `X` are
the star subalgebra generated by the generators at the sites of `X`. Every polynomial involves
finitely many sites, and polynomials of disjoint regions commute.

A local interaction is a family of self-adjoint polynomials, each supported on a finite set of
sites, with only finitely many nonzero terms through each site. Its Heisenberg derivation

`δ(A) = i Σ_i [Φ_i, A]`

is a finite sum on every polynomial. It is additive and homogeneous, obeys the Leibniz rule and
the star rule `δ(A*) = δ(A)*`, and maps polynomials to polynomials. The construction needs no
Hilbert space, no finite lattice and no particle-number sector. It applies to bosons, to bosons
coupled to two-level atoms and to any other lattice system with commuting local generators.

## ii. Key results

- `InfiniteBosons.LocalGenerators`: local generators with commuting sites.
- `InfiniteBosons.LocalGenerators.exists_finset_support`: finite support of polynomials.
- `InfiniteBosons.LocalGenerators.commute_of_disjoint`: locality.
- `InfiniteBosons.LocalGenerators.LocalInteraction`: locally finite local terms.
- `InfiniteBosons.LocalGenerators.LocalInteraction.delta_mul`, `delta_star`: the Leibniz and the
  star rule.

## iii. Table of contents

- A. Local generators and polynomials of a region
- B. Local interactions and the derivation

## iv. References

* O. Bratteli and D. Robinson, Operator Algebras and Quantum Statistical Mechanics 2, Section 6.2.
-/

@[expose] public section

open scoped BigOperators

noncomputable section

namespace InfiniteBosons

/-- A family of local generators of a star algebra: the generators at different sites commute and
each family is closed under the star. -/
structure LocalGenerators (L : Type*) (A : Type*) [Ring A] [StarRing A] [Algebra ℂ A]
    [StarModule ℂ A] where
  /-- The generators at the site `x`. -/
  gen : L → Set A
  /-- Each family is star closed. -/
  star_mem : ∀ x a, a ∈ gen x → star a ∈ gen x
  /-- Generators at different sites commute. -/
  commute : ∀ x y, x ≠ y → ∀ a ∈ gen x, ∀ b ∈ gen y, Commute a b

namespace LocalGenerators

variable {L : Type*} [DecidableEq L] {A : Type*} [Ring A] [StarRing A] [Algebra ℂ A]
  [StarModule ℂ A] (G : LocalGenerators L A)

/-- The star subalgebra of polynomials in the generators of the sites in `X`. -/
def on (X : Set L) : StarSubalgebra ℂ A := StarAlgebra.adjoin ℂ (⋃ x ∈ X, G.gen x)

lemma on_mono {X Y : Set L} (h : X ⊆ Y) : G.on X ≤ G.on Y :=
  StarAlgebra.adjoin_le fun a ha => by
    obtain ⟨x, hx, hax⟩ := Set.mem_iUnion₂.mp ha
    exact StarAlgebra.subset_adjoin ℂ _ (Set.mem_iUnion₂.mpr ⟨x, h hx, hax⟩)

lemma gen_mem_on {X : Set L} {x : L} (hx : x ∈ X) {a : A} (ha : a ∈ G.gen x) : a ∈ G.on X :=
  StarAlgebra.subset_adjoin ℂ _ (Set.mem_iUnion₂.mpr ⟨x, hx, ha⟩)

/-- **Every polynomial involves finitely many sites.** -/
lemma exists_finset_support {p : A} (hp : p ∈ G.on Set.univ) :
    ∃ Y : Finset L, p ∈ G.on (Y : Set L) := by
  refine StarAlgebra.adjoin_induction
    (p := fun p _ => ∃ Y : Finset L, p ∈ G.on (Y : Set L)) ?mem ?alg ?add ?mul ?star hp
  case mem =>
    intro a ha
    obtain ⟨x, -, hax⟩ := Set.mem_iUnion₂.mp ha
    exact ⟨{x}, G.gen_mem_on (by simp) hax⟩
  case alg => exact fun r => ⟨∅, algebraMap_mem _ r⟩
  case add =>
    rintro a b ha hb ⟨Y, hY⟩ ⟨Z, hZ⟩
    exact ⟨Y ∪ Z, add_mem (G.on_mono (by simp) hY) (G.on_mono (by simp) hZ)⟩
  case mul =>
    rintro a b ha hb ⟨Y, hY⟩ ⟨Z, hZ⟩
    exact ⟨Y ∪ Z, mul_mem (G.on_mono (by simp) hY) (G.on_mono (by simp) hZ)⟩
  case star =>
    rintro a ha ⟨Y, hY⟩
    exact ⟨Y, StarMemClass.star_mem hY⟩

/-- A generator at a site outside a region commutes with the polynomials of the region. -/
lemma commute_gen_of_not_mem {Y : Set L} {x : L} (hx : x ∉ Y) {a : A} (ha : a ∈ G.gen x) {q : A}
    (hq : q ∈ G.on Y) : Commute a q := by
  refine StarAlgebra.adjoin_induction
    (p := fun q _ => ∀ a ∈ G.gen x, Commute a q) ?mem ?alg ?add ?mul ?star hq a ha
  case mem =>
    intro b hb a ha
    obtain ⟨y, hy, hby⟩ := Set.mem_iUnion₂.mp hb
    exact G.commute x y (fun h => hx (h ▸ hy)) a ha b hby
  case alg => exact fun r a _ => Algebra.commute_algebraMap_right _ _
  case add => exact fun p q _ _ hp hq a ha => (hp a ha).add_right (hq a ha)
  case mul => exact fun p q _ _ hp hq a ha => (hp a ha).mul_right (hq a ha)
  case star =>
    intro p _ h a ha
    have := (h (star a) (G.star_mem x a ha)).star_star
    simpa using this

/-- **Locality**: polynomials of disjoint regions commute. -/
lemma commute_of_disjoint {X Y : Set L} (hXY : Disjoint X Y) {p q : A}
    (hp : p ∈ G.on X) (hq : q ∈ G.on Y) : Commute p q := by
  refine StarAlgebra.adjoin_induction
    (p := fun p _ => ∀ q, q ∈ G.on Y → Commute p q) ?mem ?alg ?add ?mul ?star hp q hq
  case mem =>
    intro a ha q hq
    obtain ⟨x, hx, hax⟩ := Set.mem_iUnion₂.mp ha
    exact G.commute_gen_of_not_mem (Set.disjoint_left.mp hXY hx) hax hq
  case alg => exact fun r q _ => Algebra.commute_algebraMap_left _ _
  case add => exact fun a b _ _ ha hb q hq => (ha q hq).add_left (hb q hq)
  case mul => exact fun a b _ _ ha hb q hq => (ha q hq).mul_left (hb q hq)
  case star =>
    intro a ha h q hq
    have := (h (star q) (StarMemClass.star_mem hq)).star_star
    simpa using this



/-- A locally finite family of self-adjoint polynomial interaction terms `Φ X`, each supported in
the finite region `X`, such that every mode lies in the support of finitely many nonzero terms. -/
structure LocalInteraction (G : LocalGenerators L A) (ι : Type*) where
  /-- The interaction terms, indexed by sites, bonds or other building blocks. -/
  Φ : ι → A
  /-- The finite set of modes on which a term acts. -/
  supp : ι → Finset L
  /-- A term is a polynomial in the modes of its support. -/
  mem_on : ∀ i, Φ i ∈ G.on (supp i : Set L)
  /-- The terms are self-adjoint. -/
  star_eq : ∀ i, star (Φ i) = Φ i
  /-- Each mode lies in the support of finitely many nonzero terms. -/
  finite_near : ∀ x : L, {i : ι | x ∈ supp i ∧ Φ i ≠ 0}.Finite

namespace LocalInteraction

variable {G : LocalGenerators L A} {ι : Type*} (I : LocalInteraction G ι)

/-- The commutator of the term of `X` with `p`. -/
def term (p : A) (i : ι) : A := I.Φ i * p - p * I.Φ i

lemma term_eq_zero_of_disjoint {Y : Set L} {p : A} (hp : p ∈ G.on Y)
    {i : ι} (h : Disjoint (I.supp i : Set L) Y) : I.term p i = 0 :=
  sub_eq_zero.mpr (G.commute_of_disjoint h (I.mem_on i) hp)

lemma term_eq_zero_of_eq_zero (p : A) {i : ι} (h : I.Φ i = 0) :
    I.term p i = 0 := by simp [term, h]

/-- The terms that can fail to commute with a polynomial supported in `Y`. -/
def near (Y : Finset L) : Set ι := ⋃ y ∈ Y, {i | y ∈ I.supp i ∧ I.Φ i ≠ 0}

lemma near_finite (Y : Finset L) : (I.near Y).Finite :=
  Set.Finite.biUnion Y.finite_toSet fun y _ => I.finite_near y

lemma support_subset_near {Y : Finset L} {p : A} (hp : p ∈ G.on (Y : Set L)) :
    Function.support (I.term p) ⊆ I.near Y := by
  intro i hi
  by_contra hn
  apply hi
  by_cases hd : Disjoint (I.supp i : Set L) (Y : Set L)
  · exact I.term_eq_zero_of_disjoint hp hd
  · by_cases h0 : I.Φ i = 0
    · exact I.term_eq_zero_of_eq_zero p h0
    · exfalso
      obtain ⟨y, hyX, hyY⟩ := Set.not_disjoint_iff.mp hd
      exact hn (Set.mem_biUnion hyY ⟨hyX, h0⟩)

/-- **The local derivation** `δ_Φ(A) = i Σ_i [Φ_i, A]`. The sum is finite on polynomials. -/
def delta (p : A) : A := Complex.I • ∑ᶠ i, I.term p i

lemma delta_eq_sum {Y : Finset L} {p : A} (hp : p ∈ G.on (Y : Set L)) :
    I.delta p = Complex.I • ∑ X ∈ (I.near_finite Y).toFinset, I.term p X := by
  unfold delta
  rw [finsum_eq_sum_of_support_subset]
  intro i hi
  simpa using I.support_subset_near hp hi


lemma term_mul (p q : A) (i : ι) :
    I.term (p * q) i = I.term p i * q + p * I.term q i := by
  simp only [term]; noncomm_ring

lemma term_star (p : A) (i : ι) :
    star (I.term p i) = - I.term (star p) i := by
  simp only [term, star_sub, star_mul, I.star_eq]; noncomm_ring

/-- **Leibniz rule** for the local derivation on polynomials. -/
theorem delta_mul {p q : A} (hp : p ∈ G.on Set.univ)
    (hq : q ∈ G.on Set.univ) :
    I.delta (p * q) = I.delta p * q + p * I.delta q := by
  obtain ⟨Y₁, h₁⟩ := G.exists_finset_support hp
  obtain ⟨Y₂, h₂⟩ := G.exists_finset_support hq
  have hp' : p ∈ G.on ((Y₁ ∪ Y₂ : Finset L) : Set L) :=
    G.on_mono (by simp) h₁
  have hq' : q ∈ G.on ((Y₁ ∪ Y₂ : Finset L) : Set L) :=
    G.on_mono (by simp) h₂
  have hpq : p * q ∈ G.on ((Y₁ ∪ Y₂ : Finset L) : Set L) := mul_mem hp' hq'
  rw [I.delta_eq_sum hpq, I.delta_eq_sum hp', I.delta_eq_sum hq']
  simp only [term_mul, Finset.sum_add_distrib, smul_add, Finset.sum_mul, Finset.mul_sum,
    smul_mul_assoc, mul_smul_comm]

/-- **Star rule** for the local derivation: `δ(A*) = δ(A)*`. -/
theorem delta_star {p : A} (hp : p ∈ G.on Set.univ) :
    I.delta (star p) = star (I.delta p) := by
  obtain ⟨Y, h⟩ := G.exists_finset_support hp
  have hs : star p ∈ G.on (Y : Set L) := StarMemClass.star_mem h
  rw [I.delta_eq_sum hs, I.delta_eq_sum h, star_smul, star_sum]
  simp only [term_star, Finset.sum_neg_distrib, smul_neg, Complex.star_def, Complex.conj_I,
    neg_smul, neg_neg]


lemma term_add (p q : A) (i : ι) :
    I.term (p + q) i = I.term p i + I.term q i := by
  simp only [term]; noncomm_ring

lemma term_smul (c : ℂ) (p : A) (i : ι) :
    I.term (c • p) i = c • I.term p i := by
  simp only [term, mul_smul_comm, smul_mul_assoc, smul_sub]

/-- The derivation is additive on polynomials. -/
theorem delta_add {p q : A} (hp : p ∈ G.on Set.univ)
    (hq : q ∈ G.on Set.univ) : I.delta (p + q) = I.delta p + I.delta q := by
  obtain ⟨Y₁, h₁⟩ := G.exists_finset_support hp
  obtain ⟨Y₂, h₂⟩ := G.exists_finset_support hq
  have hp' : p ∈ G.on ((Y₁ ∪ Y₂ : Finset L) : Set L) := G.on_mono (by simp) h₁
  have hq' : q ∈ G.on ((Y₁ ∪ Y₂ : Finset L) : Set L) := G.on_mono (by simp) h₂
  rw [I.delta_eq_sum (add_mem hp' hq'), I.delta_eq_sum hp', I.delta_eq_sum hq']
  simp only [term_add, Finset.sum_add_distrib, smul_add]

/-- The derivation is homogeneous on polynomials. -/
theorem delta_smul (c : ℂ) {p : A} (hp : p ∈ G.on Set.univ) :
    I.delta (c • p) = c • I.delta p := by
  obtain ⟨Y, h⟩ := G.exists_finset_support hp
  rw [I.delta_eq_sum (Subalgebra.smul_mem _ h c), I.delta_eq_sum h]
  simp only [term_smul, ← Finset.smul_sum, smul_comm c]

/-- **The derivation preserves the polynomial algebra.** -/
theorem delta_mem {p : A} (hp : p ∈ G.on Set.univ) :
    I.delta p ∈ G.on Set.univ := by
  obtain ⟨Y, h⟩ := G.exists_finset_support hp
  rw [I.delta_eq_sum h]
  refine Subalgebra.smul_mem _ (sum_mem fun i _ => ?_) _
  exact sub_mem (mul_mem (G.on_mono (Set.subset_univ _) (I.mem_on i)) hp)
    (mul_mem hp (G.on_mono (Set.subset_univ _) (I.mem_on i)))

end LocalInteraction


end LocalGenerators

end InfiniteBosons
