/-!

# Grönwall bounds for the Heisenberg evolution

A quadratic-form bound on the commutator with the Hamiltonian controls the growth of an
observable along the dynamics.

## i. Overview

Let `H` be a bounded self-adjoint operator and `A` a self-adjoint operator with
`Re ⟨φ, i [H, A] φ⟩ ≤ c Re ⟨φ, A φ⟩` for all `φ`. Along `ψ_t = e^{-i t H} ψ`, the expectation
`f(t) = Re ⟨ψ_t, A ψ_t⟩` satisfies `f' ≤ c f`, hence `f(t) ≤ e^{c t} f(0)` for `t ≥ 0`. This is the
abstract form of the moment bound for lattice bosons: with `A` a weighted sum of local moments
`(N_x + 1)^p`, the on-site interaction commutes with `A` and drops out, and the commutator with
hopping and pairing is bounded by `A` itself.

## ii. Key results

- `InfiniteBosons.hasDerivAt_expect`: the derivative of the expectation along the dynamics.
- `InfiniteBosons.expect_le_exp_mul`: the Grönwall bound.

## iii. Table of contents

- A. The derivative of an expectation
- B. The Grönwall bound

## iv. References

* A. Deuchert, J. Lampart, M. Lemm, Dynamics and equilibrium states of infinite systems of lattice
  bosons, arXiv:2505.13170, Proposition 4.10.
-/

@[expose] public section

noncomputable section

namespace InfiniteBosons

open NormedSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-!

## A. The derivative of an expectation

-/

/-- The Schrödinger evolution `e^{-i t H}` generated by a bounded operator. -/
def schrodinger (H : E →L[ℂ] E) (t : ℝ) : E →L[ℂ] E := exp (t • (-(Complex.I • H)))

lemma hasDerivAt_schrodinger (H : E →L[ℂ] E) (ψ : E) (t : ℝ) :
    HasDerivAt (fun s => schrodinger H s ψ) (-(Complex.I • H) (schrodinger H t ψ)) t := by
  have h := hasDerivAt_exp_smul_const' (𝕂 := ℝ) (-(Complex.I • H)) t
  have := ((ContinuousLinearMap.apply ℂ E ψ).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt t h
  simpa [schrodinger, Function.comp_def] using this

/-- **The derivative of an expectation along the dynamics** is the expectation of `i [H, A]`. -/
lemma hasDerivAt_expect (H A : E →L[ℂ] E) (hH : ∀ x y : E, inner ℂ (H x) y = inner ℂ x (H y)) (ψ : E) (t : ℝ) :
    HasDerivAt (fun s => RCLike.re (inner ℂ (schrodinger H s ψ) (A (schrodinger H s ψ))))
      (RCLike.re (inner ℂ (schrodinger H t ψ)
        ((Complex.I • (H * A - A * H)) (schrodinger H t ψ)))) t := by
  set φ := schrodinger H t ψ
  have hψ := hasDerivAt_schrodinger H ψ t
  have hAψ := (A.restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt t hψ
  have hin := hψ.inner ℂ hAψ
  have hre := (RCLike.reCLM (K := ℂ)).hasFDerivAt.comp_hasDerivAt t hin
  -- `⟨φ, A (-iH φ)⟩ + ⟨-iH φ, A φ⟩ = ⟨φ, i [H, A] φ⟩`
  have key : inner ℂ φ (A (-(Complex.I • H) φ)) + inner ℂ (-(Complex.I • H) φ) (A φ) =
      inner ℂ φ ((Complex.I • (H * A - A * H)) φ) := by
    simp only [ContinuousLinearMap.smul_apply, map_neg, map_smul,
      inner_neg_left, inner_neg_right, inner_smul_left, inner_smul_right,
      ContinuousLinearMap.sub_apply, ContinuousLinearMap.mul_apply, inner_sub_right, hH,
      Complex.conj_I]
    ring
  convert hre using 1
  · funext s; rfl
  show RCLike.re (inner ℂ φ ((Complex.I • (H * A - A * H)) φ)) =
    RCLike.re (inner ℂ φ (A (-(Complex.I • H) φ)) + inner ℂ (-(Complex.I • H) φ) (A φ))
  rw [key]

/-!

## B. The Grönwall bound

-/

/-- **Grönwall bound for the Heisenberg evolution.** If `Re ⟨φ, i [H, A] φ⟩ ≤ c Re ⟨φ, A φ⟩` for all
`φ`, then `Re ⟨ψ_t, A ψ_t⟩ ≤ e^{c t} Re ⟨ψ, A ψ⟩` for `t ≥ 0`. -/
theorem expect_le_exp_mul (H A : E →L[ℂ] E) (hH : ∀ x y : E, inner ℂ (H x) y = inner ℂ x (H y)) (c : ℝ)
    (hc : ∀ φ : E, RCLike.re (inner ℂ φ ((Complex.I • (H * A - A * H)) φ)) ≤
      c * RCLike.re (inner ℂ φ (A φ)))
    (ψ : E) {t : ℝ} (ht : 0 ≤ t) :
    RCLike.re (inner ℂ (schrodinger H t ψ) (A (schrodinger H t ψ))) ≤
      Real.exp (c * t) * RCLike.re (inner ℂ ψ (A ψ)) := by
  set f : ℝ → ℝ := fun s => RCLike.re (inner ℂ (schrodinger H s ψ) (A (schrodinger H s ψ)))
  set g : ℝ → ℝ := fun s => Real.exp (-(c * s)) * f s
  have hf := hasDerivAt_expect H A hH ψ
  have hg : ∀ s, HasDerivAt g (Real.exp (-(c * s)) * (-c) * f s + Real.exp (-(c * s)) *
      RCLike.re (inner ℂ (schrodinger H s ψ)
        ((Complex.I • (H * A - A * H)) (schrodinger H s ψ)))) s := fun s => by
    have he : HasDerivAt (fun s => Real.exp (-(c * s))) (Real.exp (-(c * s)) * (-c)) s := by
      have := ((hasDerivAt_id s).const_mul c).neg.exp
      simpa using this
    exact he.mul (hf s)
  have hanti : Antitone g := by
    refine antitone_of_deriv_nonpos (fun s => (hg s).differentiableAt) fun s => ?_
    rw [(hg s).deriv]
    have := hc (schrodinger H s ψ)
    have hpos := Real.exp_pos (-(c * s))
    nlinarith
  have h0 : schrodinger H 0 ψ = ψ := by simp [schrodinger]
  have key := hanti ht
  simp only [g, f, h0, mul_zero, neg_zero, Real.exp_zero, one_mul] at key
  have hpos := Real.exp_pos (c * t)
  calc _ = Real.exp (c * t) * (Real.exp (-(c * t)) * f t) := by
        rw [← mul_assoc, ← Real.exp_add]; simp [f]
    _ ≤ _ := mul_le_mul_of_nonneg_left key hpos.le


/-!

## C. Commutators with diagonal operators

-/

section Diagonal

variable {β : Type*} [Fintype β]

/-- **Weighted Schur test for commutators with a diagonal operator.** Let `T` be a Hermitian matrix
and `a` real eigenvalues of a diagonal operator. If every row satisfies
`Σ_β |T_{αβ}| |a_β - a_α| ≤ G_α`, then the quadratic form of `[T, a]` is bounded by the diagonal
form of `G`. -/
lemma norm_commutator_diag_le (T : β → β → ℂ) (hT : ∀ α β, T β α = starRingEnd ℂ (T α β))
    (a G : β → ℝ) (hrow : ∀ α, ∑ b, ‖T α b‖ * |a b - a α| ≤ G α) (φ : β → ℂ) :
    ‖∑ α, ∑ b, starRingEnd ℂ (φ α) * (T α b * ((a b - a α : ℝ) : ℂ)) * φ b‖ ≤
      ∑ α, G α * ‖φ α‖ ^ 2 := by
  set K : β → β → ℝ := fun α b => ‖T α b‖ * |a b - a α|
  have hK : ∀ α b, K b α = K α b := fun α b => by
    simp only [K, hT α b, RCLike.norm_conj, abs_sub_comm]
  have h1 : ‖∑ α, ∑ b, starRingEnd ℂ (φ α) * (T α b * ((a b - a α : ℝ) : ℂ)) * φ b‖ ≤
      ∑ α, ∑ b, K α b * ((‖φ α‖ ^ 2 + ‖φ b‖ ^ 2) / 2) := by
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun α _ => (norm_sum_le _ _).trans
      (Finset.sum_le_sum fun b _ => ?_))
    rw [norm_mul, norm_mul, norm_mul, RCLike.norm_conj, Complex.norm_real, Real.norm_eq_abs]
    have hk : 0 ≤ K α b := by positivity
    nlinarith [sq_nonneg (‖φ α‖ - ‖φ b‖), mul_nonneg hk (sq_nonneg (‖φ α‖ - ‖φ b‖))]
  refine h1.trans ?_
  have e : ∑ α, ∑ b, K α b * ((‖φ α‖ ^ 2 + ‖φ b‖ ^ 2) / 2) = ∑ α, ‖φ α‖ ^ 2 * ∑ b, K α b := by
    have hsplit : ∑ α, ∑ b, K α b * ((‖φ α‖ ^ 2 + ‖φ b‖ ^ 2) / 2) =
        (∑ α, ∑ b, K α b * ‖φ α‖ ^ 2 + ∑ α, ∑ b, K α b * ‖φ b‖ ^ 2) / 2 := by
      rw [eq_div_iff two_ne_zero, Finset.sum_mul, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun α _ => ?_
      rw [Finset.sum_mul, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun b _ => by ring
    have hswap : ∑ α, ∑ b, K α b * ‖φ b‖ ^ 2 = ∑ α, ∑ b, K α b * ‖φ α‖ ^ 2 := by
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun α _ => Finset.sum_congr rfl fun b _ => by rw [hK]
    rw [hsplit, hswap, add_self_div_two]
    refine Finset.sum_congr rfl fun α _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun b _ => by ring
  rw [e]
  exact Finset.sum_le_sum fun α _ => by
    rw [mul_comm (G α)]
    exact mul_le_mul_of_nonneg_left (hrow α) (by positivity)

end Diagonal

end InfiniteBosons
