module

public import PhyslibAlpha.QuantumMechanics.InfiniteBosons.FormalHamiltonian
public import PhyslibAlpha.QuantumMechanics.InfiniteBosons.EssentialSelfAdjoint
public import PhyslibAlpha.ProbabilisticTheory.HilbertSpace.Unbounded.CayleySpectralData.SpecTheorem
public import PhyslibAlpha.ProbabilisticTheory.HilbertSpace.Unbounded.Flow.Stone
public import Physlib.QuantumMechanics.Operators.SpectralTheory.Symmetric
/-!

# Domain and dynamics of the Hamiltonian of an infinite system

Density of the domain is a condition on the model. The dynamics is a theorem under essential
self-adjointness.

## i. Overview

The operator `hamPMap` of `FormalHamiltonian.lean` has the domain of finite vectors with
square-summable formal image. If the formal image of every basis vector is square summable then the
domain contains all finite vectors and is dense. If in addition the operator is essentially
self-adjoint then the unbounded spectral theorem of the Alpha tree gives the strongly continuous
unitary group `exp(i t H)`. The orbits of domain vectors have derivative `i H f`. The existence of
the dynamics is thus a theorem for a model class, never a field of a structure.

## ii. Key results

- `InfiniteBosons.hamDomainAlg_eq_top`: the domain is everything under a basis condition.
- `InfiniteBosons.hamPMap_dense`: the domain is dense.
- `InfiniteBosons.hamPMap_dynamics`: the unitary group generated by an essentially self-adjoint
  Hamiltonian.
- `InfiniteBosons.IsDiagonal`, `InfiniteBosons.hamPMap_ess_diag`: a diagonal Hamiltonian with real
  eigenvalues is essentially self-adjoint.

## iii. Table of contents

- A. Density of the domain
- B. Dynamics

## iv. References

* M. Reed, B. Simon, Methods of Modern Mathematical Physics I, Section VIII.4.
-/

@[expose] public section

open Finsupp

noncomputable section

namespace InfiniteBosons

variable {β ι : Type*} [DecidableEq β]

/-- If the formal image of every basis vector is square summable then the algebraic domain is
everything. -/
theorem hamDomainAlg_eq_top (Φ : ι → Adjointable β) (h : RowFinite Φ)
    (hb : ∀ b, Memℓp (formalH Φ h (single b 1)) 2) : hamDomainAlg Φ h = ⊤ := by
  rw [eq_top_iff]
  intro f _
  show Memℓp (formalH Φ h f) 2
  have hf : f = ∑ b ∈ f.support, f b • single b (1 : ℂ) := by
    conv_lhs => rw [← Finsupp.sum_single f]
    exact Finset.sum_congr rfl fun b _ => by simp [Finsupp.smul_single]
  rw [hf, map_sum]
  have hm := Memℓp.finsetSum (p := 2) (s := f.support)
    (f := fun b a => (formalH Φ h (f b • single b (1 : ℂ))) a) (fun b _ => by
      rw [map_smul]; exact (hb b).const_smul _)
  convert hm using 1
  funext a
  simp [Finsupp.finset_sum_apply]

/-- **Density of the domain of the Hamiltonian.** -/
theorem hamPMap_dense (Φ : ι → Adjointable β) (h : RowFinite Φ)
    (hb : ∀ b, Memℓp (formalH Φ h (single b 1)) 2) :
    (hamPMap Φ h).HasDenseDomain := by
  show Dense ((hamPMap Φ h).domain : Set (HilbertSp β))
  have : (hamPMap Φ h).domain = LinearMap.range embed := by
    show (hamDomainAlg Φ h).map embed = _
    rw [hamDomainAlg_eq_top Φ h hb, Submodule.map_top]
  rw [this]
  exact dense_range_embed


open ProbabilisticTheory ProbabilisticTheory.QuantumMechanics

/-- **Dynamics of the Hamiltonian is a theorem.** If the Hamiltonian operator is essentially
self-adjoint then it generates a strongly continuous unitary group `exp(i t H)` on `ℓ²`, and the
orbit of every vector of the algebraic domain has derivative `i H f` at time zero. -/
theorem hamPMap_dynamics (Φ : ι → Adjointable β) (h : RowFinite Φ)
    (hess : (hamPMap Φ h).IsEssentiallySelfAdjoint) :
    ∃ U : WOTSpectralMeasure.StrongUnitaryOneParameterGroup (HilbertSp β),
      (∀ t s, U (t + s) = U t * U s) ∧ U 0 = 1 ∧
      ∀ f : hamDomainAlg Φ h,
        HasDerivAt (fun t : ℝ => U t (embed f.1)) (Complex.I • (hamVec Φ h f : HilbertSp β)) 0 := by
  have D := unboundedSpectralTheorem_of_essentiallySelfAdjoint (hamPMap Φ h) hess
  refine ⟨D.expUnitaryGroup, D.expUnitaryGroup_add, D.expUnitaryGroup_zero, fun f => ?_⟩
  have hle := (hamPMap Φ h).le_closure
  have hmem : embed f.1 ∈ (hamPMap Φ h).closure.domain :=
    hle.1 (Submodule.mem_map_of_mem f.2)
  have h1 := D.expUnitaryGroup_hasDerivAt_zero ⟨embed f.1, hmem⟩
  have hval : (hamPMap Φ h).closure ⟨embed f.1, hmem⟩ = hamVec Φ h f := by
    rw [← hamPMap_apply Φ h f]
    exact (hle.2 (x := ⟨embed f.1, Submodule.mem_map_of_mem f.2⟩)
      (y := ⟨embed f.1, hmem⟩) rfl).symm
  rw [hval] at h1
  exact h1

/-- Diagonal Hamiltonian: the formal image of a basis vector is a real multiple of itself. -/
def IsDiagonal (Φ : ι → Adjointable β) (h : RowFinite Φ) (lam : β → ℝ) : Prop :=
  ∀ b α, formalH Φ h (single b 1) α = if α = b then (lam b : ℂ) else 0

lemma IsDiagonal.mem {Φ : ι → Adjointable β} {h : RowFinite Φ} {lam : β → ℝ}
    (hd : IsDiagonal Φ h lam) (b : β) : Memℓp (formalH Φ h (single b 1)) 2 := by
  have : formalH Φ h (single b 1) = fun α => if α = b then (lam b : ℂ) else 0 := funext (hd b)
  rw [this]
  rw [memℓp_gen_iff (by norm_num)]
  refine summable_of_ne_finset_zero (s := {b}) fun a ha => ?_
  have : a ≠ b := by simpa using ha
  simp [this]


lemma hamVec_diag {Φ : ι → Adjointable β} {h : RowFinite Φ} {lam : β → ℝ}
    (hd : IsDiagonal Φ h lam) (b : β) (hb : single b (1 : ℂ) ∈ hamDomainAlg Φ h) :
    hamVec Φ h ⟨single b 1, hb⟩ = (lam b : ℂ) • (lp.single 2 b (1 : ℂ) : HilbertSp β) :=
  Subtype.ext (funext fun α => by
    show formalH Φ h (single b 1) α = _
    rw [hd b α]
    show _ = ((lam b : ℂ) • (lp.single 2 b (1 : ℂ) : HilbertSp β)) α
    rw [lp.coeFn_smul, Pi.smul_apply, smul_eq_mul]
    by_cases hα : α = b
    · subst hα; simp
    · simp [hα, lp.single_apply_ne _ _ _ (Ne.symm hα)])

/-- **A diagonal Hamiltonian is essentially self-adjoint.** -/
theorem hamPMap_ess_diag (Φ : ι → Adjointable β) (h : RowFinite Φ) (hs : ∀ i, star (Φ i) = Φ i)
    (lam : β → ℝ) (hd : IsDiagonal Φ h lam) : (hamPMap Φ h).IsEssentiallySelfAdjoint := by
  have hdense := hamPMap_dense Φ h hd.mem
  have hsym := hamPMap_isSymmetric Φ h hs
  have hdef : ∀ z : ℂ, z.im ≠ 0 → (hamPMap Φ h).defectNumber z = 0 := by
    intro z hz
    have hzne : ∀ α, (lam α : ℂ) - z ≠ 0 := fun α h0 => by
      have := congrArg Complex.im h0; simp at this; exact hz this
    have hbot : ((hamPMap Φ h) - z • (1 : HilbertSp β →ₗ.[ℂ] HilbertSp β)).toFun.rangeᗮ = ⊥ := by
      rw [Submodule.eq_bot_iff]
      intro x hx
      refine lp.ext (funext fun α => ?_)
      have hmemA : single α (1 : ℂ) ∈ hamDomainAlg Φ h := by
        rw [hamDomainAlg_eq_top Φ h hd.mem]; trivial
      have hmem : embed (single α (1 : ℂ)) ∈
          ((hamPMap Φ h) - z • (1 : HilbertSp β →ₗ.[ℂ] HilbertSp β)).domain := by
        simp only [LinearPMap.sub_domain, LinearPMap.smul_domain, LinearPMap.one_domain]
        exact ⟨Submodule.mem_map_of_mem hmemA, Submodule.mem_top⟩
      have hval : ((hamPMap Φ h) - z • (1 : HilbertSp β →ₗ.[ℂ] HilbertSp β))
          ⟨embed (single α (1 : ℂ)), hmem⟩ = ((lam α : ℂ) - z) • (lp.single 2 α (1 : ℂ) : HilbertSp β) := by
        rw [LinearPMap.sub_apply, LinearPMap.smul_apply]
        rw [hamPMap_apply Φ h ⟨single α 1, hmemA⟩, hamVec_diag hd α hmemA]
        have h1 : (1 : HilbertSp β →ₗ.[ℂ] HilbertSp β) ⟨embed (single α (1 : ℂ)), Submodule.mem_top⟩ =
            (lp.single 2 α (1 : ℂ) : HilbertSp β) := by
          rw [← embed_single]; rfl
        rw [h1, sub_smul]
      have hy := hx _ ⟨⟨embed (single α (1 : ℂ)), hmem⟩, rfl⟩
      change inner ℂ (((hamPMap Φ h) - z • (1 : HilbertSp β →ₗ.[ℂ] HilbertSp β))
        ⟨embed (single α (1 : ℂ)), hmem⟩) x = 0 at hy
      rw [hval, inner_smul_left, lp.inner_single_left] at hy
      have hc : starRingEnd ℂ ((lam α : ℂ) - z) ≠ 0 := by
        intro h0; exact hzne α ((map_eq_zero (starRingEnd ℂ)).mp h0)
      have : inner ℂ (1 : ℂ) (x α) = 0 := by
        rcases mul_eq_zero.mp hy with h1 | h1
        · exact absurd h1 hc
        · exact h1
      simpa using this
    show Module.rank ℂ ((hamPMap Φ h - z • (1 : HilbertSp β →ₗ.[ℂ] HilbertSp β)).toFun.rangeᗮ) = 0
    rw [hbot]; exact rank_bot ℂ _
  exact LinearPMap.IsSymmetric.isEssentiallySelfAdjoint_of_defectNumber_eq_zero hsym hdense
    (hdef _ (by simp)) (hdef _ (by simp))

end InfiniteBosons
