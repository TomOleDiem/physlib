public import PhyslibAlpha.QuantumMechanics.InfiniteBosons.FockPre
public import Physlib.Mathematics.Modules.ConjModule
/-!

# The polynomial CCR star algebra of an arbitrary mode set

The algebra generated by creation and annihilation operators, as formally adjointable operators of
the algebraic Fock space.

## i. Overview

The formally adjointable operators of the algebraic Fock space form a star algebra. A pair `(T, S)`
of operators is adjointable when `S` is the formal adjoint of `T` for the sesquilinear pairing of the
occupation basis. The second component lives on the conjugate module so that scalars `r` have the
adjoint `conj r`. The polynomial CCR algebra `P(L)` of the mode set `L` is the star subalgebra
generated by the annihilation operators. It contains `a_x`, `a_x†`, the number operators `N_x`, the
hopping terms `a_x† a_y`, the products `N_x N_y` and the pairing terms `a_x a_y`. Every element is
a finite polynomial in the generators. Neither the modes nor the lattice are assumed finite.

## ii. Key results

- `InfiniteBosons.adjointable`: the algebra of formally adjointable operators.
- `InfiniteBosons.polynomialAlgebra`: the polynomial CCR star algebra.
- `InfiniteBosons.numberOp_mem`, `InfiniteBosons.hopping_mem`, `InfiniteBosons.pairing_mem`:
  the physical polynomial observables lie in it.

## iii. Table of contents

- A. Formally adjointable operators
- B. The star structure
- C. Creation and annihilation operators
- D. The polynomial CCR star algebra

## iv. References

* J. Dereziński and C. Gérard, Mathematics of Quantization and Quantum Fields, Cambridge
  University Press (2013).
* K. Schmüdgen, Unbounded Operator Algebras and Representation Theory, Birkhäuser (1990).
-/

@[expose] public section

open Finsupp

noncomputable section

namespace InfiniteBosons

variable {B : Type*} [DecidableEq B]

/-- The pairs `(T, S)` of operators on the algebraic Fock space where `S` is the formal adjoint
of `T`. The second component lives on the conjugate module so that the pairs form an algebra over
`ℂ`. -/
def Adjointable (B : Type*) [DecidableEq B] :
    Subalgebra ℂ (Module.End ℂ ((B →₀ ℂ)) × (Module.End ℂ (ConjModule ((B →₀ ℂ))))ᵐᵒᵖ) where
  carrier := {p | ∀ f g : (B →₀ ℂ),
    pair (p.1 f) g = pair f ((conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm
      (MulOpposite.unop p.2 (conjEquiv (k := ℂ) (M := (B →₀ ℂ)) g)))}
  mul_mem' := by
    intro p q hp hq f g
    have h1 := hp (q.1 f) g
    set g' := (conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm
      (MulOpposite.unop p.2 (conjEquiv (k := ℂ) (M := (B →₀ ℂ)) g)) with hg'
    have h2 := hq f g'
    have e : conjEquiv (k := ℂ) (M := (B →₀ ℂ)) g' =
        MulOpposite.unop p.2 (conjEquiv (k := ℂ) (M := (B →₀ ℂ)) g) := by
      simp [hg']
    rw [e] at h2
    show pair (p.1 (q.1 f)) g = pair f ((conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm
      (MulOpposite.unop q.2 (MulOpposite.unop p.2 (conjEquiv (k := ℂ) (M := (B →₀ ℂ)) g))))
    rw [h1, h2]
  one_mem' := by
    intro f g; rfl
  add_mem' := by
    intro p q hp hq f g
    show pair (p.1 f + q.1 f) g = pair f ((conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm
      (MulOpposite.unop p.2 (conjEquiv (k := ℂ) (M := (B →₀ ℂ)) g) +
        MulOpposite.unop q.2 (conjEquiv (k := ℂ) (M := (B →₀ ℂ)) g)))
    rw [map_add, pair_add_left, pair_add_right, hp f g, hq f g]
  zero_mem' := by
    intro f g; simp [pair_zero_left, pair_zero_right]
  algebraMap_mem' := by
    intro r f g
    show pair (r • f) g = pair f ((conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm
      (r • conjEquiv (k := ℂ) (M := (B →₀ ℂ)) g))
    have e : (conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm
        (r • conjEquiv (k := ℂ) (M := (B →₀ ℂ)) g) = (starRingEnd ℂ r) • g := by
      apply (conjEquiv (k := ℂ) (M := (B →₀ ℂ))).injective
      rw [LinearEquiv.apply_symm_apply, map_smulₛₗ, starRingEnd_self_apply]
    rw [e, pair_smul_left, pair_smul_right]


/-- Reading an operator of the conjugate module as an operator of the module. -/
def toEnd (S : Module.End ℂ (ConjModule ((B →₀ ℂ)))) : Module.End ℂ ((B →₀ ℂ)) :=
  (conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm.toLinearMap ∘ₛₗ S ∘ₛₗ
    (conjEquiv (k := ℂ) (M := (B →₀ ℂ))).toLinearMap

/-- Reading an operator of the module as an operator of the conjugate module. -/
def ofEnd (T : Module.End ℂ ((B →₀ ℂ))) : Module.End ℂ (ConjModule ((B →₀ ℂ))) :=
  (conjEquiv (k := ℂ) (M := (B →₀ ℂ))).toLinearMap ∘ₛₗ T ∘ₛₗ
    (conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm.toLinearMap

lemma toEnd_apply (S : Module.End ℂ (ConjModule ((B →₀ ℂ)))) (f : (B →₀ ℂ)) :
    toEnd S f = (conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm (S (conjEquiv (k := ℂ) (M := (B →₀ ℂ)) f)) :=
  rfl

lemma ofEnd_apply (T : Module.End ℂ ((B →₀ ℂ))) (f : ConjModule ((B →₀ ℂ))) :
    ofEnd T f = conjEquiv (k := ℂ) (M := (B →₀ ℂ)) (T ((conjEquiv (k := ℂ) (M := (B →₀ ℂ))).symm f)) :=
  rfl


/-- The algebra of formally adjointable operators is a ring. -/
instance instRingAdjointable : Ring (Adjointable B) :=
  @Subalgebra.toRing ℂ (Module.End ℂ ((B →₀ ℂ)) × (Module.End ℂ (ConjModule ((B →₀ ℂ))))ᵐᵒᵖ)
    _ _ _ (Adjointable B)

lemma mem_adjointable {p : Module.End ℂ ((B →₀ ℂ)) × (Module.End ℂ (ConjModule ((B →₀ ℂ))))ᵐᵒᵖ} :
    p ∈ Adjointable B ↔ ∀ f g : (B →₀ ℂ), pair (p.1 f) g = pair f (toEnd (MulOpposite.unop p.2) g) :=
  Iff.rfl

lemma toEnd_ofEnd (T : Module.End ℂ ((B →₀ ℂ))) : toEnd (ofEnd T) = T := by
  ext f; rfl

lemma ofEnd_toEnd (S : Module.End ℂ (ConjModule ((B →₀ ℂ)))) : ofEnd (toEnd S) = S := by
  ext f; simp [ofEnd_apply, toEnd_apply]

/-- The formal adjoint of a pair is the swapped pair. -/
def adjStar (p : Adjointable B) : Adjointable B :=
  ⟨(toEnd (MulOpposite.unop p.1.2), MulOpposite.op (ofEnd p.1.1)), by
    rw [mem_adjointable]
    intro f g
    simp only [MulOpposite.unop_op, toEnd_ofEnd]
    have hp := mem_adjointable.mp p.2 g f
    rw [pair_conj_symm, ← hp, ← pair_conj_symm]⟩


lemma toEnd_add (S S' : Module.End ℂ (ConjModule ((B →₀ ℂ)))) :
    toEnd (S + S') = toEnd S + toEnd S' := by ext f; rfl

lemma ofEnd_add (T T' : Module.End ℂ ((B →₀ ℂ))) : ofEnd (T + T') = ofEnd T + ofEnd T' := by
  ext f; rfl

lemma toEnd_mul (S S' : Module.End ℂ (ConjModule ((B →₀ ℂ)))) :
    toEnd (S * S') = toEnd S * toEnd S' := by
  ext f
  simp [toEnd_apply, Module.End.mul_apply]

lemma ofEnd_mul (T T' : Module.End ℂ ((B →₀ ℂ))) : ofEnd (T * T') = ofEnd T * ofEnd T' := by
  ext f
  simp [ofEnd_apply, Module.End.mul_apply]

instance : Star (Adjointable B) := ⟨adjStar⟩

lemma star_def' (p : Adjointable B) : star p = adjStar p := rfl

instance : StarRing (Adjointable B) where
  star_involutive p := by
    refine Subtype.ext (Prod.ext ?_ ?_)
    · show toEnd (MulOpposite.unop (MulOpposite.op (ofEnd p.1.1))) = p.1.1
      simp [toEnd_ofEnd]
    · show MulOpposite.op (ofEnd (toEnd (MulOpposite.unop p.1.2))) = p.1.2
      simp [ofEnd_toEnd]
  star_mul p q := by
    refine Subtype.ext (Prod.ext ?_ ?_)
    · show toEnd (MulOpposite.unop (p.1.2 * q.1.2)) = toEnd (MulOpposite.unop q.1.2) * toEnd (MulOpposite.unop p.1.2)
      rw [MulOpposite.unop_mul, toEnd_mul]
    · show MulOpposite.op (ofEnd (p.1.1 * q.1.1)) = MulOpposite.op (ofEnd q.1.1) * MulOpposite.op (ofEnd p.1.1)
      rw [ofEnd_mul, ← MulOpposite.op_mul]
  star_add p q := by
    refine Subtype.ext (Prod.ext ?_ ?_)
    · show toEnd (MulOpposite.unop (p.1.2 + q.1.2)) = toEnd (MulOpposite.unop p.1.2) + toEnd (MulOpposite.unop q.1.2)
      rw [MulOpposite.unop_add, toEnd_add]
    · show MulOpposite.op (ofEnd (p.1.1 + q.1.1)) = MulOpposite.op (ofEnd p.1.1) + MulOpposite.op (ofEnd q.1.1)
      rw [ofEnd_add, MulOpposite.op_add]


lemma toEnd_smul (c : ℂ) (S : Module.End ℂ (ConjModule ((B →₀ ℂ)))) :
    toEnd (c • S) = (starRingEnd ℂ c) • toEnd S := by
  refine LinearMap.ext fun f => ?_
  simp only [toEnd_apply, LinearMap.smul_apply]
  rw [map_smulₛₗ]

lemma ofEnd_smul (c : ℂ) (T : Module.End ℂ ((B →₀ ℂ))) :
    ofEnd (c • T) = (starRingEnd ℂ c) • ofEnd T := by
  refine LinearMap.ext fun f => ?_
  simp only [ofEnd_apply, LinearMap.smul_apply]
  rw [map_smulₛₗ]

instance : StarModule ℂ (Adjointable B) where
  star_smul c p := by
    refine Subtype.ext (Prod.ext ?_ ?_)
    · show toEnd (MulOpposite.unop (c • p.1.2)) = (starRingEnd ℂ c) • toEnd (MulOpposite.unop p.1.2)
      rw [MulOpposite.unop_smul, toEnd_smul]
    · show MulOpposite.op (ofEnd (c • p.1.1)) = (starRingEnd ℂ c) • MulOpposite.op (ofEnd p.1.1)
      rw [ofEnd_smul, MulOpposite.op_smul]

lemma pair_single_left (α : B) (h : B →₀ ℂ) : pair (single α 1) h = h α := by
  simp [pair]

/-- **An adjointable pair is determined by its first component.** -/
lemma adjointable_ext {p q : Adjointable B} (h : p.1.1 = q.1.1) : p = q := by
  refine Subtype.ext (Prod.ext h ?_)
  have key : toEnd (MulOpposite.unop p.1.2) = toEnd (MulOpposite.unop q.1.2) := by
    refine LinearMap.ext fun g => ?_
    refine Finsupp.ext fun α => ?_
    rw [← pair_single_left α, ← pair_single_left α (toEnd (MulOpposite.unop q.1.2) g),
      ← mem_adjointable.mp p.2 (single α 1) g, ← mem_adjointable.mp q.2 (single α 1) g, h]
  have := congrArg ofEnd key
  rw [ofEnd_toEnd, ofEnd_toEnd] at this
  exact MulOpposite.unop_injective this

variable {L : Type*} [DecidableEq L]

/-- The algebra of formally adjointable operators of the algebraic Fock space of the modes `L`. -/
abbrev adjointable (L : Type*) [DecidableEq L] := Adjointable (Occ L)

/-- The annihilation operator of the mode `x` as an element of the algebra of formally adjointable
operators. -/
def annOp (x : L) : adjointable L :=
  ⟨(ann x, MulOpposite.op (ofEnd (cre x))), by
    rw [mem_adjointable]
    intro f g
    simp only [MulOpposite.unop_op, toEnd_ofEnd]
    exact pair_ann x f g⟩

/-- The creation operator of the mode `x` as an element of the algebra of formally adjointable
operators. -/
def creOp (x : L) : adjointable L :=
  ⟨(cre x, MulOpposite.op (ofEnd (ann x))), by
    rw [mem_adjointable]
    intro f g
    simp only [MulOpposite.unop_op, toEnd_ofEnd]
    exact pair_cre x f g⟩

lemma star_annOp (x : L) : star (annOp x) = creOp x := by
  refine Subtype.ext (Prod.ext ?_ ?_)
  · show toEnd (MulOpposite.unop (MulOpposite.op (ofEnd (cre x)))) = cre x
    simp [toEnd_ofEnd]
  · rfl

lemma star_creOp (x : L) : star (creOp x) = annOp x := by
  refine Subtype.ext (Prod.ext ?_ ?_)
  · show toEnd (MulOpposite.unop (MulOpposite.op (ofEnd (ann x)))) = ann x
    simp [toEnd_ofEnd]
  · rfl


/-!

## D. The polynomial CCR *-algebra

-/

/-- **The polynomial CCR *-algebra** `P(L)`: the star algebra generated by the creation and
annihilation operators of all modes. -/
def polynomialAlgebra (L : Type*) [DecidableEq L] : StarSubalgebra ℂ (adjointable L) :=
  StarAlgebra.adjoin ℂ (Set.range annOp)

lemma annOp_mem (x : L) : annOp x ∈ polynomialAlgebra L :=
  StarAlgebra.subset_adjoin ℂ _ ⟨x, rfl⟩

lemma creOp_mem (x : L) : creOp x ∈ polynomialAlgebra L := by
  rw [← star_annOp]
  exact star_mem (annOp_mem x)

/-- The number operator `N_x = a_x† a_x`. -/
def numberOp (x : L) : adjointable L := creOp x * annOp x

lemma numberOp_mem (x : L) : numberOp x ∈ polynomialAlgebra L :=
  mul_mem (creOp_mem x) (annOp_mem x)

lemma numberOp_mul_mem (x y : L) : numberOp x * numberOp y ∈ polynomialAlgebra L :=
  mul_mem (numberOp_mem x) (numberOp_mem y)

lemma hopping_mem (x y : L) : creOp x * annOp y ∈ polynomialAlgebra L :=
  mul_mem (creOp_mem x) (annOp_mem y)

lemma pairing_mem (x y : L) : annOp x * annOp y ∈ polynomialAlgebra L :=
  mul_mem (annOp_mem x) (annOp_mem y)

/-- **The canonical commutation relations hold in the algebra**: `[a_x, a_y†] = δ_xy`. -/
lemma annOp_creOp_comm (x y : L) :
    annOp x * creOp y = creOp y * annOp x + if x = y then 1 else 0 := by
  refine adjointable_ext ?_
  by_cases hxy : x = y
  · subst hxy
    simp only [if_true]
    show ann x ∘ₗ cre x = cre x ∘ₗ ann x + LinearMap.id
    rw [← ann_cre_comm_same x]; abel
  · simp only [hxy, if_false, add_zero]
    show ann x ∘ₗ cre y = cre y ∘ₗ ann x
    exact ann_cre_comm_ne hxy

end InfiniteBosons
