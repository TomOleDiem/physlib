/-!

# The regular representation of the Weyl relations

Weyl unitaries on `ℓ²` of a symplectic space, with no distinguished Fock representation.

## i. Overview

For a real vector space `V` with an alternating form `σ`, the space `ℓ²(V)` carries the unitaries

`(W(f) ψ)(h) = exp(-iσ(f, h)/2) ψ(h - f)`.

They satisfy the Weyl relation `W(f) W(g) = exp(-iσ(f, g)/2) W(f + g)` and `W(0) = 1`. The
construction uses only the translation of coordinates of `ℓ²(V)` and multiplication by a
unimodular phase, both of which are unitary. The space `V` may be infinite dimensional, of any
cardinality, and `σ` may be degenerate. Hence the bounded operators generated by the Weyl
unitaries form a C*-algebra of the CCR for the symplectic space, independent of any state or
Fock representation.

## ii. Key results

- `InfiniteBosons.reindexEquiv`: reindexing `ℓ²` along a bijection is unitary.
- `InfiniteBosons.phaseEquiv`: multiplication by unimodular numbers is unitary.
- `InfiniteBosons.weylU`: the Weyl unitary.
- `InfiniteBosons.weylU_mul`: the Weyl relation.
- `InfiniteBosons.weylRegular`: a `WeylRep` in the bounded operators of `ℓ²(V)`.

## iii. Table of contents

- A. Unitary reindexing and phases
- B. The regular representation

## iv. References

* O. Bratteli and D. Robinson, Operator Algebras and Quantum Statistical Mechanics 2, Section 5.2.
-/

@[expose] public section

open Finsupp

noncomputable section

namespace InfiniteBosons

variable {α β γ : Type*}

lemma memℓp_comp_equiv (e : α ≃ β) (f : HilbertSp β) :
    Memℓp (fun a => (f (e a))) 2 := by
  have hf := lp.memℓp f
  rw [memℓp_gen_iff (by norm_num)] at hf ⊢
  exact (e.summable_iff).mpr hf

/-- Reindexing `ℓ²` along a bijection. -/
def reindex (e : α ≃ β) : HilbertSp β →ₗᵢ[ℂ] HilbertSp α where
  toFun f := ⟨fun a => f (e a), memℓp_comp_equiv e f⟩
  map_add' f g := Subtype.ext (funext fun a => by
    show (f + g : HilbertSp β) (e a) = f (e a) + g (e a)
    rw [lp.coeFn_add]; rfl)
  map_smul' r f := Subtype.ext (funext fun a => by
    show (r • f : HilbertSp β) (e a) = r * f (e a)
    rw [lp.coeFn_smul]; rfl)
  norm_map' f := by
    have h2 : (2 : ENNReal).toReal = 2 := by norm_num
    set g : HilbertSp α := ⟨fun a => f (e a), memℓp_comp_equiv e f⟩ with hg
    have h1 := lp.norm_rpow_eq_tsum (by norm_num : 0 < (2 : ENNReal).toReal) f
    have h3 := lp.norm_rpow_eq_tsum (by norm_num : 0 < (2 : ENNReal).toReal) g
    rw [h2] at h1 h3
    have h4 : ‖g‖ ^ (2 : ℝ) = ‖f‖ ^ (2 : ℝ) := by
      rw [h1, h3]
      exact e.tsum_eq (fun b => ‖(f b)‖ ^ (2 : ℝ))
    rw [Real.rpow_two, Real.rpow_two] at h4
    exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp h4


/-- Reindexing `ℓ²` along a bijection is a unitary equivalence. -/
def reindexEquiv (e : α ≃ β) : HilbertSp β ≃ₗᵢ[ℂ] HilbertSp α :=
  LinearIsometryEquiv.ofSurjective (reindex e) (fun g => by
    refine ⟨reindex e.symm g, Subtype.ext (funext fun a => ?_)⟩
    show (g (e.symm (e a))) = g a
    simp)

lemma reindexEquiv_apply (e : α ≃ β) (f : HilbertSp β) (a : α) :
    (reindexEquiv e f : HilbertSp α) a = f (e a) := rfl

lemma reindexEquiv_trans_apply (e : α ≃ β) (e' : β ≃ γ) (f : HilbertSp γ) :
    reindexEquiv e (reindexEquiv e' f) = reindexEquiv (e.trans e') f := rfl

/-- Multiplication by a sequence of unimodular numbers is a unitary of `ℓ²`. -/
def phaseEquiv {B : Type*} (c : B → ℂ) (hc : ∀ b, ‖c b‖ = 1) : HilbertSp B ≃ₗᵢ[ℂ] HilbertSp B :=
  LinearIsometryEquiv.ofSurjective
    { toFun := fun f => ⟨fun b => c b * f b, memℓp_mul_two (C := 1) (fun b => (hc b).le) f⟩
      map_add' := fun f g => Subtype.ext (funext fun b => by
        show c b * ((f + g : HilbertSp B) b) = c b * f b + c b * g b
        rw [lp.coeFn_add]; simp [mul_add])
      map_smul' := fun r f => Subtype.ext (funext fun b => by
        show c b * ((r • f : HilbertSp B) b) = r * (c b * f b)
        rw [lp.coeFn_smul]; simp [mul_left_comm])
      norm_map' := fun f => by
        have h2 : (2 : ENNReal).toReal = 2 := by norm_num
        set g : HilbertSp B := ⟨fun b => c b * f b, memℓp_mul_two (C := 1) (fun b => (hc b).le) f⟩
          with hg
        have h1 := lp.norm_rpow_eq_tsum (by norm_num : 0 < (2 : ENNReal).toReal) f
        have h3 := lp.norm_rpow_eq_tsum (by norm_num : 0 < (2 : ENNReal).toReal) g
        rw [h2] at h1 h3
        have h4 : ‖g‖ ^ (2 : ℝ) = ‖f‖ ^ (2 : ℝ) := by
          rw [h1, h3]
          refine tsum_congr fun b => ?_
          show ‖c b * f b‖ ^ (2 : ℝ) = ‖f b‖ ^ (2 : ℝ)
          rw [norm_mul, hc b, one_mul]
        rw [Real.rpow_two, Real.rpow_two] at h4
        exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp h4 }
    (fun g => by
      refine ⟨⟨fun b => starRingEnd ℂ (c b) * g b, memℓp_mul_two (C := 1) (fun b => by
        simpa using (hc b).le) g⟩, Subtype.ext (funext fun b => ?_)⟩
      show c b * (starRingEnd ℂ (c b) * g b) = g b
      have : c b * starRingEnd ℂ (c b) = 1 := by
        rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hc b]; simp
      rw [← mul_assoc, this, one_mul])


section Regular

variable {V : Type*} [AddCommGroup V] [Module ℝ V] (σ : V →ₗ[ℝ] V →ₗ[ℝ] ℝ)

/-- The phase `exp(-iσ(f, h)/2)` of the regular representation of the Weyl relations. -/
def weylPhase (f h : V) : ℂ := Complex.exp (-(Complex.I * (σ f h : ℂ)) / 2)

lemma norm_weylPhase (f h : V) : ‖weylPhase σ f h‖ = 1 := by
  rw [weylPhase, Complex.norm_exp]
  simp

/-- **The Weyl unitary in the regular representation**: `(W(f) ψ)(h) = e^{-iσ(f,h)/2} ψ(h - f)`. -/
def weylU (f : V) : HilbertSp V ≃ₗᵢ[ℂ] HilbertSp V :=
  (reindexEquiv (Equiv.subRight f)).trans (phaseEquiv (weylPhase σ f) (norm_weylPhase σ f))

lemma weylU_apply (f : V) (ψ : HilbertSp V) (h : V) :
    (weylU σ f ψ : HilbertSp V) h = weylPhase σ f h * ψ (h - f) := rfl


lemma skew_of_alt' (hσ : ∀ f, σ f f = 0) (f g : V) : σ g f = - σ f g := by
  have := hσ (f + g)
  simp only [map_add, LinearMap.add_apply, hσ] at this
  linarith

lemma weylPhase_mul (hσ : ∀ f, σ f f = 0) (f g h : V) :
    weylPhase σ f h * weylPhase σ g (h - f) =
      Complex.exp (-(Complex.I * (σ f g : ℂ)) / 2) * weylPhase σ (f + g) h := by
  unfold weylPhase
  rw [← Complex.exp_add, ← Complex.exp_add]
  congr 1
  have h1 : σ g (h - f) = σ g h - σ g f := by simp
  have h2 : σ (f + g) h = σ f h + σ g h := by simp
  rw [h1, h2, skew_of_alt' σ hσ f g]
  push_cast
  ring

/-- **The Weyl relation in the regular representation.** -/
lemma weylU_mul (hσ : ∀ f, σ f f = 0) (f g : V) (ψ : HilbertSp V) :
    weylU σ f (weylU σ g ψ) =
      Complex.exp (-(Complex.I * (σ f g : ℂ)) / 2) • weylU σ (f + g) ψ := by
  refine Subtype.ext (funext fun h => ?_)
  rw [weylU_apply, weylU_apply]
  show _ = Complex.exp (-(Complex.I * (σ f g : ℂ)) / 2) * (weylU σ (f + g) ψ : HilbertSp V) h
  rw [weylU_apply, sub_sub]
  rw [← mul_assoc, weylPhase_mul σ hσ f g h]
  ring


/-- The Weyl operator as a bounded operator of `ℓ²(V)`. -/
def weylOp (f : V) : HilbertSp V →L[ℂ] HilbertSp V :=
  (weylU σ f).toContinuousLinearEquiv.toContinuousLinearMap

lemma weylOp_apply (f : V) (ψ : HilbertSp V) : weylOp σ f ψ = weylU σ f ψ := rfl

lemma weylU_zero : weylU σ 0 = LinearIsometryEquiv.refl ℂ (HilbertSp V) := by
  refine LinearIsometryEquiv.ext fun ψ => Subtype.ext (funext fun h => ?_)
  rw [weylU_apply]
  show _ = ψ h
  simp [weylPhase]

lemma weylU_neg_comp (hσ : ∀ f, σ f f = 0) (f : V) (ψ : HilbertSp V) :
    weylU σ (-f) (weylU σ f ψ) = ψ := by
  rw [weylU_mul σ hσ, neg_add_cancel, weylU_zero]
  have h0 := hσ f
  simp [h0]

lemma weylU_comp_neg (hσ : ∀ f, σ f f = 0) (f : V) (ψ : HilbertSp V) :
    weylU σ f (weylU σ (-f) ψ) = ψ := by
  rw [weylU_mul σ hσ, add_neg_cancel, weylU_zero]
  have h0 := hσ f
  simp [h0]

/-- **The regular representation of the Weyl relations** on `ℓ²(V)`: the Weyl unitaries of a
symplectic space are bounded operators. -/
def weylRegular (hσ : ∀ f, σ f f = 0) : WeylAlgebra.WeylRep σ (HilbertSp V →L[ℂ] HilbertSp V) where
  W := weylOp σ
  W_zero := by
    refine ContinuousLinearMap.ext fun ψ => ?_
    rw [weylOp_apply, weylU_zero]; rfl
  star_W f := by
    rw [ContinuousLinearMap.star_eq_adjoint]
    symm
    rw [ContinuousLinearMap.eq_adjoint_iff]
    intro x y
    rw [weylOp_apply, weylOp_apply]
    have : weylU σ (-f) x = (weylU σ f).symm x := by
      rw [LinearIsometryEquiv.eq_symm_apply]
      exact weylU_comp_neg σ hσ f x
    rw [this]
    exact (weylU σ f).inner_map_map _ _ |>.symm.trans (by rw [LinearIsometryEquiv.apply_symm_apply])
  W_mul f g := by
    refine ContinuousLinearMap.ext fun ψ => ?_
    show weylU σ f (weylU σ g ψ) = _
    rw [weylU_mul σ hσ]
    rfl

end Regular

end InfiniteBosons
