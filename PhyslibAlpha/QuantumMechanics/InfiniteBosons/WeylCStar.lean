# The Weyl C*-net of a symplectic space

The C*-algebras generated by Weyl unitaries of a region, their isotony and their locality.

## i. Overview

For a region `S` of the symplectic space `V` the Weyl C*-algebra of `S` is the norm closure of
the star algebra generated in `B(ℓ²(V))` by the Weyl unitaries `W(f)` with `f ∈ S`. It is a
C*-algebra. Bigger regions give bigger algebras. If two regions are orthogonal for the symplectic
form then every element of the first algebra commutes with every element of the second, because
the generating unitaries commute and commutation passes to norm limits. For a lattice the regions
are the fields supported in subsets of sites, and the orthogonality holds for disjoint subsets.
No Fock representation, no finiteness of the lattice and no state is used.

## ii. Key results

- `InfiniteBosons.weylCStarOn`: the Weyl C*-algebra of a region.
- `InfiniteBosons.weylCStarOn_mono`: isotony.
- `InfiniteBosons.weyl_locality`: commutation of the algebras of orthogonal regions.

## iii. Table of contents

- A. Topology of the bounded operators
- B. The algebras of regions
- C. Locality

## iv. References

* O. Bratteli and D. Robinson, Operator Algebras and Quantum Statistical Mechanics 2, Section 5.2.
* J. Dereziński and C. Gérard, Mathematics of Quantization and Quantum Fields, Cambridge
  University Press (2013), Chapter 17.
-/

@[expose] public section

open Finsupp

noncomputable section

namespace InfiniteBosons

variable {V : Type*} [AddCommGroup V] [Module ℝ V] (σ : V →ₗ[ℝ] V →ₗ[ℝ] ℝ)

instance : Nontrivial (HilbertSp V) := by
  classical
  refine ⟨lp.single 2 (0 : V) 1, 0, fun h => ?_⟩
  have := congrArg (fun f : HilbertSp V => f 0) h
  simp at this


instance : IsTopologicalRing (HilbertSp V →L[ℂ] HilbertSp V) := by
  letI : CStarAlgebra (HilbertSp V →L[ℂ] HilbertSp V) := inferInstance
  exact inferInstance

instance : ContinuousStar (HilbertSp V →L[ℂ] HilbertSp V) := by
  letI : CStarAlgebra (HilbertSp V →L[ℂ] HilbertSp V) := inferInstance
  exact inferInstance

/-- The C*-algebra generated by the Weyl unitaries of the vectors in `S`, in the regular
representation. -/
def weylCStarOn (S : Set V) : StarSubalgebra ℂ (HilbertSp V →L[ℂ] HilbertSp V) :=
  (StarAlgebra.adjoin ℂ (weylOp σ '' S)).topologicalClosure

lemma weylOp_mem_cstar {S : Set V} {f : V} (hf : f ∈ S) : weylOp σ f ∈ weylCStarOn σ S :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨f, hf, rfl⟩)

lemma weylCStarOn_mono {S T : Set V} (h : S ⊆ T) : weylCStarOn σ S ≤ weylCStarOn σ T :=
  StarSubalgebra.topologicalClosure_mono (StarAlgebra.adjoin_mono (Set.image_mono h))

lemma isClosed_weylCStarOn (S : Set V) :
    IsClosed (weylCStarOn σ S : Set (HilbertSp V →L[ℂ] HilbertSp V)) := isClosed_closure

instance (S : Set V) : CompleteSpace (weylCStarOn σ S) :=
  (isClosed_weylCStarOn σ S).completeSpace_coe

instance (S : Set V) : CStarAlgebra (weylCStarOn σ S) :=
  letI : CStarAlgebra (HilbertSp V →L[ℂ] HilbertSp V) := inferInstance
  { }


lemma commute_weylOp (hσ : ∀ f, σ f f = 0) {f g : V} (h : σ f g = 0) :
    Commute (weylOp σ f) (weylOp σ g) := by
  have := WeylAlgebra.WeylRep.mul_comm_phase (weylRegular σ hσ) hσ f g
  show weylOp σ f * weylOp σ g = weylOp σ g * weylOp σ f
  have e : (weylRegular σ hσ).W = weylOp σ := rfl
  rw [e] at this
  rw [this, h]
  simp

lemma commute_of_adjoin {A : Type*} [Ring A] [StarRing A] [Algebra ℂ A] [StarModule ℂ A]
    {S T : Set A} (hS : ∀ s ∈ S, star s ∈ S) (hT : ∀ t ∈ T, star t ∈ T)
    (h : ∀ s ∈ S, ∀ t ∈ T, Commute s t) {a b : A} (ha : a ∈ StarAlgebra.adjoin ℂ S)
    (hb : b ∈ StarAlgebra.adjoin ℂ T) : Commute a b := by
  -- first: generators of `S` commute with everything in the algebra generated by `T`
  have step : ∀ s ∈ S, ∀ b ∈ StarAlgebra.adjoin ℂ T, Commute s b := by
    intro s hs b hb
    refine StarAlgebra.adjoin_induction
      (p := fun b _ => ∀ s ∈ S, Commute s b) ?mem ?alg ?add ?mul ?star hb s hs
    case mem => exact fun t ht s hs => h s hs t ht
    case alg => exact fun r s _ => Algebra.commute_algebraMap_right _ _
    case add => exact fun x y _ _ hx hy s hs => (hx s hs).add_right (hy s hs)
    case mul => exact fun x y _ _ hx hy s hs => (hx s hs).mul_right (hy s hs)
    case star =>
      intro x _ hx s hs
      have := (hx (star s) (hS s hs)).star_star
      simpa using this
  refine StarAlgebra.adjoin_induction
    (p := fun a _ => ∀ b ∈ StarAlgebra.adjoin ℂ T, Commute a b) ?mem ?alg ?add ?mul ?star ha b hb
  case mem => exact fun s hs b hb => step s hs b hb
  case alg => exact fun r b _ => Algebra.commute_algebraMap_left _ _
  case add => exact fun x y _ _ hx hy b hb => (hx b hb).add_left (hy b hb)
  case mul => exact fun x y _ _ hx hy b hb => (hx b hb).mul_left (hy b hb)
  case star =>
    intro x hx hcx b hb
    have := (hcx (star b) (star_mem hb)).star_star
    simpa using this


lemma star_weylOp (hσ : ∀ f, σ f f = 0) (f : V) : star (weylOp σ f) = weylOp σ (-f) :=
  (weylRegular σ hσ).star_W f

/-- **Locality of the Weyl C*-net**: Weyl algebras of regions that are `σ`-orthogonal commute. -/
theorem weyl_locality (hσ : ∀ f, σ f f = 0) {S T : Set V} (hS : ∀ f ∈ S, -f ∈ S)
    (hT : ∀ f ∈ T, -f ∈ T) (h : ∀ f ∈ S, ∀ g ∈ T, σ f g = 0) {a b : HilbertSp V →L[ℂ] HilbertSp V}
    (ha : a ∈ weylCStarOn σ S) (hb : b ∈ weylCStarOn σ T) : Commute a b := by
  have hgen : ∀ a ∈ StarAlgebra.adjoin ℂ (weylOp σ '' S), ∀ b ∈ StarAlgebra.adjoin ℂ (weylOp σ '' T),
      Commute a b := by
    intro a ha b hb
    refine commute_of_adjoin (S := weylOp σ '' S) (T := weylOp σ '' T) ?_ ?_ ?_ ha hb
    · rintro _ ⟨f, hf, rfl⟩
      exact ⟨-f, hS f hf, (star_weylOp σ hσ f).symm⟩
    · rintro _ ⟨f, hf, rfl⟩
      exact ⟨-f, hT f hf, (star_weylOp σ hσ f).symm⟩
    · rintro _ ⟨f, hf, rfl⟩ _ ⟨g, hg, rfl⟩
      exact commute_weylOp σ hσ (h f hf g hg)
  -- pass to the closures
  have hcl : ∀ a ∈ weylCStarOn σ S, ∀ b ∈ StarAlgebra.adjoin ℂ (weylOp σ '' T), Commute a b := by
    intro a ha b hb
    have hclosed : IsClosed {a : HilbertSp V →L[ℂ] HilbertSp V | Commute a b} :=
      isClosed_eq (by fun_prop) (by fun_prop)
    have hsub : (StarAlgebra.adjoin ℂ (weylOp σ '' S) : Set _) ⊆ {a | Commute a b} :=
      fun a ha => hgen a ha b hb
    exact (closure_minimal hsub hclosed) ha
  have hclosed : IsClosed {b : HilbertSp V →L[ℂ] HilbertSp V | Commute a b} :=
    isClosed_eq (by fun_prop) (by fun_prop)
  have hsub : (StarAlgebra.adjoin ℂ (weylOp σ '' T) : Set _) ⊆ {b | Commute a b} :=
    fun b hb => hcl a ha b hb
  exact (closure_minimal hsub hclosed) hb

end InfiniteBosons
