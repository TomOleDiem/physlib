/-!

# From a polynomial observable to a bounded one: the resolvent

A symmetric polynomial observable whose shifted operator `A ± i` has dense range has a bounded
resolvent.

## i. Overview

For a symmetric operator `A` on the algebraic Fock space the identity
`‖(A + i c) f‖² = ‖A f‖² + c² ‖f‖²` holds. Hence `A + i c` is injective and bounded below by `|c|`.
Its inverse on the range has norm at most `1/|c|`. If the range is dense then the inverse extends
to a bounded operator on `ℓ²`. Density of the range of `A ± i` is the basic criterion for essential
self-adjointness. The resolvent is a bounded observable. The resolvent algebra generated by such
operators is the C*-framework of Buchholz and Grundling for unbounded observables. The hypothesis
is explicit and is not a field of any structure: it has to be proved for each model.

## ii. Key results

- `InfiniteBosons.shiftMap`: the operator `A + i c` from the algebraic space to `ℓ²`.
- `InfiniteBosons.norm_sq_shiftMap`: `‖(A + i c) f‖² = ‖A f‖² + c² ‖f‖²`.
- `InfiniteBosons.exists_resolvent`: the bounded resolvent under the density hypothesis.
- `InfiniteBosons.polyOp_resolvent`: the same for a self-adjoint polynomial observable.

## iii. Table of contents

- A. The shifted operator
- B. The resolvent

## iv. References

* D. Buchholz, H. Grundling, The resolvent algebra: a new approach to canonical quantum systems,
  J. Funct. Anal. 254 (2008) 2725.
* M. Reed, B. Simon, Methods of Modern Mathematical Physics I, Theorem VIII.3.
-/

@[expose] public section

open Finsupp

noncomputable section

namespace InfiniteBosons
variable {B : Type*} [DecidableEq B]

/-- The shifted operator `A + i c` applied to a finite vector, in `ℓ²`. -/
def shiftMap (A : (B →₀ ℂ) →ₗ[ℂ] (B →₀ ℂ)) (c : ℝ) : (B →₀ ℂ) →ₗ[ℂ] HilbertSp B :=
  embed ∘ₗ (A + ((Complex.I * c : ℂ)) • LinearMap.id)

lemma norm_sq_shiftMap (A : (B →₀ ℂ) →ₗ[ℂ] (B →₀ ℂ))
    (hsym : ∀ f g, pair (A f) g = pair f (A g)) (c : ℝ) (f : B →₀ ℂ) :
    ‖shiftMap A c f‖ ^ 2 = ‖embed (A f)‖ ^ 2 + c ^ 2 * ‖embed f‖ ^ 2 := by
  have hsm : shiftMap A c f = embed (A f) + ((Complex.I * c : ℂ)) • embed f := by
    simp [shiftMap]
  rw [hsm, norm_add_sq (𝕜 := ℂ)]
  have h1 : ‖((Complex.I * c : ℂ)) • embed f‖ ^ 2 = c ^ 2 * ‖embed f‖ ^ 2 := by
    rw [norm_smul, mul_pow]; simp
  have h2 : RCLike.re (inner ℂ (embed (A f)) (((Complex.I * c : ℂ)) • embed f)) = 0 := by
    rw [inner_smul_right]
    have hs : inner ℂ (embed (A f)) (embed f) = inner ℂ (embed f) (embed (A f)) := by
      rw [inner_embed, inner_embed, hsym]
    have him : (inner ℂ (embed (A f)) (embed f)).im = 0 := by
      have h3 := inner_conj_symm (𝕜 := ℂ) (embed f) (embed (A f))
      rw [← hs] at h3
      exact Complex.conj_eq_iff_im.mp h3
    simp [Complex.mul_re, him]
  rw [h1, h2]; ring

lemma norm_le_shiftMap (A : (B →₀ ℂ) →ₗ[ℂ] (B →₀ ℂ))
    (hsym : ∀ f g, pair (A f) g = pair f (A g)) {c : ℝ} (hc : c ≠ 0) (f : B →₀ ℂ) :
    ‖embed f‖ ≤ (1 / |c|) * ‖shiftMap A c f‖ := by
  have h := norm_sq_shiftMap A hsym c f
  have hpos : 0 < |c| := abs_pos.mpr hc
  rw [div_mul_eq_mul_div, one_mul, le_div_iff₀ hpos]
  have : (‖embed f‖ * |c|) ^ 2 ≤ ‖shiftMap A c f‖ ^ 2 := by
    rw [mul_pow, sq_abs, h]; nlinarith [sq_nonneg ‖embed (A f)‖]
  exact le_of_sq_le_sq this (norm_nonneg _)

lemma shiftMap_injective (A : (B →₀ ℂ) →ₗ[ℂ] (B →₀ ℂ))
    (hsym : ∀ f g, pair (A f) g = pair f (A g)) {c : ℝ} (hc : c ≠ 0) :
    Function.Injective (shiftMap A c) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro f hf
  have := norm_le_shiftMap A hsym hc f
  rw [hf, norm_zero, mul_zero] at this
  exact embed_injective (by simpa using norm_le_zero_iff.mp this)

/-- **The resolvent of a symmetric polynomial operator.** If `A` is symmetric and the range of
`A + i c` is dense then there is a bounded operator `R` of norm at most `1/|c|` that inverts
`A + i c` on the algebraic space. Density of the range of `A ± i` is the criterion for essential
self-adjointness. -/
theorem exists_resolvent (A : (B →₀ ℂ) →ₗ[ℂ] (B →₀ ℂ))
    (hsym : ∀ f g, pair (A f) g = pair f (A g)) {c : ℝ} (hc : c ≠ 0)
    (hdense : Dense (LinearMap.range (shiftMap A c) : Set (HilbertSp B))) :
    ∃ R : HilbertSp B →L[ℂ] HilbertSp B, ‖R‖ ≤ 1 / |c| ∧ ∀ f, R (shiftMap A c f) = embed f := by
  set P := shiftMap A c with hP
  let E := LinearMap.range P
  let R0lin : E →ₗ[ℂ] HilbertSp B :=
    embed ∘ₗ (LinearEquiv.ofInjective P (shiftMap_injective A hsym hc)).symm.toLinearMap
  have hR0 : ∀ y : E, ‖R0lin y‖ ≤ (1 / |c|) * ‖y‖ := by
    intro y
    obtain ⟨f, hf⟩ := y.2
    have : (LinearEquiv.ofInjective P (shiftMap_injective A hsym hc)).symm y = f := by
      rw [LinearEquiv.symm_apply_eq]; exact Subtype.ext hf.symm
    show ‖embed ((LinearEquiv.ofInjective P (shiftMap_injective A hsym hc)).symm y)‖ ≤ _
    rw [this]
    have h := norm_le_shiftMap A hsym hc f
    have hn : ‖y‖ = ‖P f‖ := by
      rw [show P f = (y : HilbertSp B) from hf]; rfl
    rw [hn]
    exact h
  let R0 : E →L[ℂ] HilbertSp B := LinearMap.mkContinuous R0lin (1 / |c|) hR0
  have hdense' : DenseRange (Submodule.subtypeL E) := by
    simpa [DenseRange, Submodule.range_subtypeL] using hdense
  have hind : IsUniformInducing (Submodule.subtypeL E) :=
    (Submodule.subtypeₗᵢ E).isometry.isUniformInducing
  refine ⟨R0.extend (Submodule.subtypeL E), ?_, fun f => ?_⟩
  · have h1 := ContinuousLinearMap.opNorm_extend_le (N := 1) R0 (e := Submodule.subtypeL E)
      hdense' (fun x => by simp)
    have h2 : ‖R0‖ ≤ 1 / |c| := LinearMap.mkContinuous_norm_le _ (by positivity) _
    simp only [NNReal.coe_one, one_mul] at h1
    simpa using h1.trans h2
  · have := ContinuousLinearMap.extend_eq R0 hdense' hind ⟨P f, LinearMap.mem_range_self P f⟩
    refine this.trans ?_
    show embed ((LinearEquiv.ofInjective P (shiftMap_injective A hsym hc)).symm _) = _
    have : (LinearEquiv.ofInjective P (shiftMap_injective A hsym hc)).symm
        ⟨P f, LinearMap.mem_range_self P f⟩ = f := by
      rw [LinearEquiv.symm_apply_eq]; rfl
    rw [this]

/-- **Bridge to a bounded observable.** A self-adjoint polynomial observable `p` whose shifted
operator `p + i c` has dense range has a bounded resolvent. Density of the range of `p ± i` is
the essential self-adjointness hypothesis. -/
theorem polyOp_resolvent (p : Adjointable B) (hp : star p = p) {c : ℝ} (hc : c ≠ 0)
    (hdense : Dense (LinearMap.range (shiftMap p.1.1 c) : Set (HilbertSp B))) :
    ∃ R : HilbertSp B →L[ℂ] HilbertSp B, ‖R‖ ≤ 1 / |c| ∧
      ∀ f, R (shiftMap p.1.1 c f) = embed f :=
  exists_resolvent p.1.1 (fun f g => by
    have := star_fst_pair p f g
    rwa [hp] at this) hc hdense

lemma lpSingle_eq_smul (α : B) (r : ℂ) :
    (lp.single 2 α r : HilbertSp B) = r • (lp.single 2 α (1 : ℂ) : HilbertSp B) := by
  rw [← lp.single_smul]; simp

/-- **Density criterion for a diagonal operator**: if `A` has the basis vectors as eigenvectors with
real eigenvalues then the range of `A + i c` is dense for `c ≠ 0`. -/
lemma dense_range_shiftMap_of_diag (A : (B →₀ ℂ) →ₗ[ℂ] (B →₀ ℂ)) (lam : B → ℝ)
    (hA : ∀ α, A (single α 1) = (lam α : ℂ) • single α 1) {c : ℝ} (hc : c ≠ 0) :
    Dense (LinearMap.range (shiftMap A c) : Set (HilbertSp B)) := by
  have hne : ∀ α, ((lam α : ℂ) + Complex.I * c) ≠ 0 := fun α h => by
    have := congrArg Complex.im h
    simp at this; exact hc this
  have hmem : ∀ α, lp.single 2 α (1 : ℂ) ∈ LinearMap.range (shiftMap A c) := fun α => by
    refine ⟨((lam α : ℂ) + Complex.I * c)⁻¹ • single α 1, ?_⟩
    rw [map_smul]
    have : shiftMap A c (single α 1) = ((lam α : ℂ) + Complex.I * c) • lp.single 2 α (1 : ℂ) := by
      have e1 : shiftMap A c (single α 1) = embed (A (single α 1)) +
          ((Complex.I * c : ℂ)) • embed (single α 1) := by
        simp only [shiftMap, LinearMap.comp_apply, LinearMap.add_apply, LinearMap.smul_apply,
          LinearMap.id_apply, map_add, map_smul]
      rw [e1, hA, map_smul, embed_single, add_smul]
    rw [this, smul_smul, inv_mul_cancel₀ (hne α), one_smul]
  have hsp : ∀ α (d : ℂ), lp.single 2 α d ∈ LinearMap.range (shiftMap A c) := fun α d => by
    have := Submodule.smul_mem _ d (hmem α)
    rwa [← lpSingle_eq_smul] at this
  intro f
  have h := lp.hasSum_single (E := fun _ : B => ℂ) (p := 2) ENNReal.ofNat_ne_top f
  refine mem_closure_of_tendsto h (Filter.Eventually.of_forall fun t => ?_)
  exact Submodule.sum_mem _ fun i _ => hsp i (f i)

/-- **Essential self-adjointness from finite invariant blocks.** Let `A` be symmetric. Suppose
every basis vector lies in a finite set `F` of basis vectors whose span is mapped into itself by
`A`. Then the range of `A + i c` is dense for every `c ≠ 0`. This is the case for number
conserving operators acting on finitely many modes. -/
lemma dense_range_shiftMap_of_finite_invariant (A : (B →₀ ℂ) →ₗ[ℂ] (B →₀ ℂ))
    (hsym : ∀ f g, pair (A f) g = pair f (A g))
    (hinv : ∀ α, ∃ F : Finset B, α ∈ F ∧ ∀ β ∈ F, ((A (single β 1)).support : Set B) ⊆ F)
    {c : ℝ} (hc : c ≠ 0) :
    Dense (LinearMap.range (shiftMap A c) : Set (HilbertSp B)) := by
  have hsingle : ∀ α, lp.single 2 α (1 : ℂ) ∈ LinearMap.range (shiftMap A c) := by
    intro α
    obtain ⟨F, hαF, hF⟩ := hinv α
    let S : Submodule ℂ (B →₀ ℂ) := Submodule.span ℂ ((fun β => single β (1 : ℂ)) '' (F : Set B))
    have hfin : FiniteDimensional ℂ S :=
      FiniteDimensional.span_of_finite ℂ ((F.finite_toSet).image _)
    have hAS : ∀ f ∈ S, A f ∈ S := by
      intro f hf
      induction hf using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨β, hβ, rfl⟩ := hx
        have hsub := hF β hβ
        have : A (single β 1) ∈ Finsupp.supported ℂ ℂ (F : Set B) := hsub
        rw [Finsupp.supported_eq_span_single] at this
        exact this
      | zero => simp
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | smul r x _ hx => rw [map_smul]; exact Submodule.smul_mem _ r hx
    set K : (B →₀ ℂ) →ₗ[ℂ] (B →₀ ℂ) := A + ((Complex.I * c : ℂ)) • (LinearMap.id : (B →₀ ℂ) →ₗ[ℂ] (B →₀ ℂ)) with hK
    have hinj : Function.Injective K := by
      intro u v huv
      refine shiftMap_injective A hsym hc ?_
      show embed (K u) = embed (K v)
      rw [huv]
    have hmap : ∀ f ∈ S, K f ∈ S := by
      intro f hf
      rw [hK]
      simp only [LinearMap.add_apply, LinearMap.smul_apply, LinearMap.id_apply]
      exact add_mem (hAS f hf) (Submodule.smul_mem _ _ hf)
    let T : S →ₗ[ℂ] S := K.restrict hmap
    have hTinj : Function.Injective T := by
      intro u v huv
      exact Subtype.ext (hinj (congrArg Subtype.val huv))
    haveI := hfin
    have hTsurj : Function.Surjective T := by
      have := hfin
      exact LinearMap.surjective_of_injective (K := ℂ) (V := S) (f := T) hTinj
    have hα : single α (1 : ℂ) ∈ S := Submodule.subset_span ⟨α, hαF, rfl⟩
    obtain ⟨g, hg⟩ := hTsurj ⟨single α 1, hα⟩
    refine ⟨g.1, ?_⟩
    have : K g.1 = single α 1 :=
      congrArg Subtype.val hg
    show embed (K g.1) = _
    rw [this, embed_single]
  intro f
  have h := lp.hasSum_single (E := fun _ : B => ℂ) (p := 2) ENNReal.ofNat_ne_top f
  refine mem_closure_of_tendsto h (Filter.Eventually.of_forall fun t => ?_)
  refine Submodule.sum_mem _ fun i _ => ?_
  rw [lpSingle_eq_smul]
  exact Submodule.smul_mem _ _ (hsingle i)

end InfiniteBosons
