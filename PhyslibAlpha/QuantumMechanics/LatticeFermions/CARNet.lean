module

public import PhyslibAlpha.QuantumMechanics.LatticeFermions.FockSpace
public import PhyslibAlpha.QuantumMechanics.LatticeFermions.GradedLocalNet
public import Mathlib.Algebra.Star.UnitaryStarAlgAut

/-!

# The graded local net of lattice fermions

The local CAR algebras of the finite regions of a lattice, generated by the annihilators of the
modes at the sites of the region, form a graded local net.

## i. Overview

Each mode `m` of a fermion system sits at a site `site m` of a lattice `V`; a site may carry
several modes, for instance the two spin states of an electron. The *local CAR algebra* `𝔄_X` of
a finite region `X` is the norm closure of the star subalgebra of the bounded operators on the
Fock space generated by the annihilators `c_m` with `site m ∈ X`; it contains their adjoints, the
creators. It grows with `X`. (With finitely many modes per site it is finite dimensional, so the
closure changes nothing; taking it makes the local algebras closed without that argument.)

The *parity* `Θ(A) = (-1)^N A (-1)^N` is conjugation by the parity operator, a `⋆`-automorphism
with `Θ² = 1` and `Θ(c_m) = -c_m`. It preserves every local algebra.

Even-odd locality follows from the anticommutation relations. Let `g` be an annihilator or a
creator at a site outside `Y`. It anticommutes with every generator of `𝔄_Y`, and the parity
reverses the sign of every generator, so by induction over products and sums,
`g B = Θ(B) g` for all `B ∈ 𝔄_Y`. For even `B` this says that `g` commutes with `B`, and `B*` is
even as well, so `B` commutes with the whole star algebra generated by such `g`, which contains
the generated algebra of `X` for `X` disjoint from `Y`. Even-odd locality passes to the norm
closures.

## ii. Key results

- `LatticeFermions.carGen` : the star algebra generated by the annihilators of a region.
- `LatticeFermions.parityAut` : the parity automorphism `Θ`.
- `LatticeFermions.mul_eq_parityAut_mul` : `g B = Θ(B) g` for `g` outside the support of `B`.
- `LatticeFermions.carNet` : the graded local net of lattice fermions.
- `LatticeFermions.carLocal` : the local CAR algebra of a region.

## iii. Table of contents

- A. The local CAR algebras
- B. The parity automorphism
- C. Twisted commutation with operators outside a region
- D. The graded local net

## iv. References

* O. Bratteli, D. W. Robinson, Operator Algebras and Quantum Statistical Mechanics 2,
  Section 5.2.2.

-/

@[expose] public section

noncomputable section

namespace LatticeFermions

variable {M : Type*} [LinearOrder M] {V : Type*} (site : M → V)

/-!

## A. The local CAR algebras

-/

/-- The annihilators of the modes at the sites of `X`. -/
def annSet (X : Set V) : Set (FockOp M) := {a | ∃ m, site m ∈ X ∧ a = ann m}

/-- The star subalgebra generated by the annihilators of the modes at the sites of a region. Its
norm closure is the local CAR algebra. -/
def carGen (X : Finset V) : StarSubalgebra ℂ (FockOp M) :=
  StarAlgebra.adjoin ℂ (annSet site (X : Set V))

variable {site}

lemma ann_mem_carGen {X : Finset V} {m : M} (hm : site m ∈ X) : ann m ∈ carGen site X :=
  StarAlgebra.subset_adjoin ℂ _ ⟨m, hm, rfl⟩

lemma cre_mem_carGen {X : Finset V} {m : M} (hm : site m ∈ X) : cre m ∈ carGen site X := by
  rw [← star_ann]; exact star_mem (ann_mem_carGen hm)

lemma carGen_mono : Monotone (carGen site) := fun _ _ h =>
  StarAlgebra.adjoin_mono fun _ ⟨m, hm, ha⟩ => ⟨m, h hm, ha⟩

/-- The generators of a local CAR algebra as an algebra: annihilators and creators. -/
lemma carGen_toSubalgebra (X : Finset V) :
    (carGen site X).toSubalgebra =
      Algebra.adjoin ℂ (annSet site (X : Set V) ∪ star (annSet site (X : Set V))) :=
  StarAlgebra.adjoin_toSubalgebra _ _

/-!

## B. The parity automorphism

-/

variable (M) in
/-- The parity operator as a unitary. -/
def parityUnitary : unitary (FockOp M) := ⟨parityOp, parityOp_mem_unitary⟩

variable (M) in
/-- The parity automorphism `Θ(A) = (-1)^N A (-1)^N`. -/
def parityAut : FockOp M ≃⋆ₐ[ℂ] FockOp M := Unitary.conjStarAlgAut ℂ _ (parityUnitary M)

omit [LinearOrder M] in
lemma parityAut_apply (a : FockOp M) : parityAut M a = parityOp * a * parityOp := by
  simp [parityAut, parityUnitary, star_parityOp]

omit [LinearOrder M] in
lemma parityAut_parityAut (a : FockOp M) : parityAut M (parityAut M a) = a := by
  simp only [parityAut_apply, ← mul_assoc, parityOp_mul_self, one_mul]
  rw [mul_assoc, parityOp_mul_self, mul_one]

lemma parityAut_ann (m : M) : parityAut M (ann m) = -ann m := by
  rw [parityAut_apply, parityOp_mul_ann, neg_mul, mul_assoc, parityOp_mul_self, mul_one]

lemma parityAut_cre (m : M) : parityAut M (cre m) = -cre m := by
  rw [← star_ann, map_star, parityAut_ann, star_neg]

omit [LinearOrder M] in
/-- A product of two odd elements is even. -/
lemma parityAut_mul_of_neg {a b : FockOp M} (ha : parityAut M a = -a)
    (hb : parityAut M b = -b) : parityAut M (a * b) = a * b := by
  rw [map_mul, ha, hb, neg_mul_neg]

lemma parityAut_numOp (m : M) : parityAut M (numOp m) = numOp m :=
  parityAut_mul_of_neg (parityAut_cre m) (parityAut_ann m)

lemma parityAut_mem {X : Finset V} {a : FockOp M} (ha : a ∈ carGen site X) :
    parityAut M a ∈ carGen site X := by
  have hle : carGen site X ≤ (carGen site X).comap (StarAlgHom.ofClass (parityAut M)) :=
    StarAlgebra.adjoin_le fun _ ⟨m, hm, h⟩ => by
      subst h
      show parityAut M (ann m) ∈ carGen site X
      rw [parityAut_ann]
      exact neg_mem (ann_mem_carGen hm)
  exact hle ha

/-!

## C. Twisted commutation with operators outside a region

-/

/-- If `g` anticommutes with every element of `s`, and an automorphism `θ` reverses the sign of
every element of `s`, then `g b = θ(b) g` for every `b` in the algebra generated by `s`. -/
lemma mul_eq_of_mem_adjoin {A : Type*} [Ring A] [Algebra ℂ A] (θ : A →ₐ[ℂ] A) {s : Set A}
    {g : A} (hg : ∀ h ∈ s, g * h = -(h * g)) (hθ : ∀ h ∈ s, θ h = -h) {b : A}
    (hb : b ∈ Algebra.adjoin ℂ s) : g * b = θ b * g := by
  induction hb using Algebra.adjoin_induction with
  | mem h hh => rw [hg h hh, hθ h hh, neg_mul]
  | algebraMap r => rw [AlgHom.commutes, Algebra.commutes]
  | add x y _ _ hx hy => rw [mul_add, hx, hy, map_add, add_mul]
  | mul x y _ _ hx hy => rw [← mul_assoc, hx, mul_assoc, hy, map_mul, mul_assoc]

/-- An annihilator or creator `g` of a mode at a site outside `Y` satisfies `g B = Θ(B) g` for
every `B ∈ 𝔄_Y`. -/
lemma mul_eq_parityAut_mul {Y : Finset V} {g : FockOp M} {m : M} (hm : site m ∉ Y)
    (hg : g = ann m ∨ g = cre m) {b : FockOp M} (hb : b ∈ carGen site Y) :
    g * b = parityAut M b * g := by
  have hb' : b ∈ (carGen site Y).toSubalgebra := hb
  rw [carGen_toSubalgebra] at hb'
  refine mul_eq_of_mem_adjoin (AlgHom.ofClass (parityAut M)) ?_ ?_ hb'
  · rintro h (⟨n, hn, rfl⟩ | ⟨n, hn, hh⟩)
    · have hmn : m ≠ n := fun h => hm (h ▸ hn)
      rcases hg with rfl | rfl
      · exact ann_mul_ann m n
      · exact cre_mul_ann_of_ne hmn
    · have hmn : m ≠ n := fun h => hm (h ▸ hn)
      have hh' : h = cre n := by rw [← star_ann, ← hh, star_star]
      subst hh'
      rcases hg with rfl | rfl
      · exact ann_mul_cre_of_ne hmn
      · exact cre_mul_cre m n
  · rintro h (⟨n, _, rfl⟩ | ⟨n, _, hh⟩)
    · exact parityAut_ann n
    · have hh' : h = cre n := by rw [← star_ann, ← hh, star_star]
      subst hh'
      exact parityAut_cre n

/-- Even-odd locality of the CAR algebras. -/
lemma commute_of_disjoint_carGen {X Y : Finset V} (hXY : Disjoint X Y) {a b : FockOp M}
    (ha : a ∈ carGen site X) (hb : b ∈ carGen site Y) (hbe : parityAut M b = b) :
    Commute a b := by
  have hcomm : ∀ {m : M}, site m ∈ X → ∀ {c : FockOp M}, c ∈ carGen site Y →
      parityAut M c = c → Commute (ann m) c := by
    intro m hm c hc hce
    have hmY : site m ∉ Y := Finset.disjoint_left.mp hXY hm
    have := mul_eq_parityAut_mul hmY (Or.inl rfl) hc
    rw [hce] at this
    exact this
  have hle : carGen site X ≤ StarSubalgebra.centralizer ℂ {b} :=
    StarAlgebra.adjoin_le fun _ ⟨m, hm, h⟩ => by
      subst h
      rw [SetLike.mem_coe, StarSubalgebra.mem_centralizer_iff]
      rintro _ rfl
      refine ⟨(hcomm hm hb hbe).symm.eq, ?_⟩
      exact (hcomm hm (star_mem hb) (by rw [map_star, hbe])).symm.eq
  have h := hle ha
  rw [StarSubalgebra.mem_centralizer_iff] at h
  exact (h b rfl).1.symm

/-!

## D. The graded local net

-/

variable (site) in
/-- The graded local net of lattice fermions: the norm closures of the star algebras generated by
the annihilators of the regions, with the parity `(-1)^N`. -/
def carNet : GradedLocalNet V (FockOp M) :=
  GradedLocalNet.ofClosure (parityAut M) (carGen site) carGen_mono parityAut_parityAut
    (fun _ _ hb => parityAut_mem hb)
    (fun hXY _ ha _ hb hbe => commute_of_disjoint_carGen hXY ha hb hbe)

variable (site) in
/-- The local CAR algebra of a finite region: the norm closure of the star algebra generated by
the annihilators of the modes at its sites. -/
abbrev carLocal (X : Finset V) : StarSubalgebra ℂ (FockOp M) := (carNet site).loc X

lemma carGen_le_carLocal (X : Finset V) : carGen site X ≤ carLocal site X :=
  StarSubalgebra.le_topologicalClosure _

lemma ann_mem_carLocal {X : Finset V} {m : M} (hm : site m ∈ X) : ann m ∈ carLocal site X :=
  carGen_le_carLocal X (ann_mem_carGen hm)

lemma cre_mem_carLocal {X : Finset V} {m : M} (hm : site m ∈ X) : cre m ∈ carLocal site X :=
  carGen_le_carLocal X (cre_mem_carGen hm)

lemma carNet_parity : (carNet site).parity = parityAut M := rfl

end LatticeFermions
