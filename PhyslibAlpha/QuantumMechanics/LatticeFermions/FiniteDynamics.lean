/-!

# The dynamics generated by a bounded Hamiltonian

The Heisenberg dynamics `α_t(A) = e^{itH} A e^{-itH}` of a self-adjoint element `H` of a
C⋆-algebra: a group of isometric `⋆`-automorphisms solving the Heisenberg equation.

## i. Overview

The Hamiltonian of a finite region of a lattice system is a self-adjoint element `H` of the
C⋆-algebra of observables. The *propagator* `U(t) = e^{itH}` is a unitary, and
`U(s + t) = U(s) U(t)` because `sH` and `tH` commute. Conjugation by it,

`α_t(A) = U(t) A U(t)*`,

is a `⋆`-automorphism, `α_{s+t} = α_s ∘ α_t`, and `‖α_t(A)‖ = ‖A‖`. Differentiating the
exponentials gives the *Heisenberg equation* `d/dt α_t(A) = α_t(i[H, A])`.

Two structural facts are used for the thermodynamic limit. If `H` and `A` lie in a closed star
subalgebra, so does `α_t(A)`, since `e^{itH}` is a norm limit of polynomials in `H`. If a
`⋆`-automorphism `Θ` fixes `H`, for instance the parity when `H` is even, it commutes with `α_t`.

## ii. Key results

- `LatticeFermions.propagator` : the unitary `e^{itH}`.
- `LatticeFermions.propagator_add` : the group law of the propagators.
- `LatticeFermions.evolution` : the automorphism `α_t`.
- `LatticeFermions.evolution_add` : the group law of the dynamics.
- `LatticeFermions.norm_evolution` : `α_t` is isometric.
- `LatticeFermions.hasDerivAt_evolution` : the Heisenberg equation.
- `LatticeFermions.evolution_mem` : closed star subalgebras containing `H` are invariant.
- `LatticeFermions.map_evolution` : automorphisms fixing `H` commute with the dynamics.
- `LatticeFermions.evolution_neg_hamiltonian` : reversing `H` reverses time.
- `LatticeFermions.evolution_add_of_commute` : a term commuting with `H` and `A` does not change
  the dynamics of `A`.

## iii. Table of contents

- A. The propagator
- B. The Heisenberg dynamics
- C. The Heisenberg equation
- D. Invariant subalgebras and symmetries
- E. Inverse, time reversal and commuting Hamiltonians

## iv. References

* O. Bratteli, D. W. Robinson, Operator Algebras and Quantum Statistical Mechanics 2,
  Section 6.2.1.

-/

@[expose] public section

noncomputable section

namespace LatticeFermions

open NormedSpace Complex

variable {𝔄 : Type*} [CStarAlgebra 𝔄]

/-!

## A. The propagator

-/

/-- The propagator `e^{itH}` of a self-adjoint element `H`. -/
def propagator (H : selfAdjoint 𝔄) (t : ℝ) : unitary 𝔄 := selfAdjoint.expUnitary (t • H)

lemma propagator_coe (H : selfAdjoint 𝔄) (t : ℝ) :
    (propagator H t : 𝔄) = exp ((t : ℂ) • (I • (H : 𝔄))) := by
  rw [propagator, selfAdjoint.expUnitary_coe, selfAdjoint.val_smul, smul_comm,
    ← Complex.coe_smul]

lemma propagator_zero (H : selfAdjoint 𝔄) : propagator H 0 = 1 := by
  simp [propagator]

lemma propagator_add (H : selfAdjoint 𝔄) (s t : ℝ) :
    propagator H (s + t) = propagator H s * propagator H t := by
  rw [propagator, add_smul]
  refine Commute.expUnitary_add ?_
  simp only [selfAdjoint.val_smul]
  exact ((Commute.refl (H : 𝔄)).smul_left s).smul_right t

lemma star_propagator (H : selfAdjoint 𝔄) (t : ℝ) :
    star (propagator H t) = propagator H (-t) := by
  have h : propagator H t * propagator H (-t) = 1 := by
    rw [← propagator_add, add_neg_cancel, propagator_zero]
  rw [Unitary.star_eq_inv]
  exact inv_eq_of_mul_eq_one_right h

lemma commute_propagator (H : selfAdjoint 𝔄) (t : ℝ) :
    Commute (H : 𝔄) (propagator H t : 𝔄) := by
  rw [propagator_coe]
  exact ((Commute.refl (H : 𝔄)).smul_right I |>.smul_right (t : ℂ)).exp_right

/-!

## B. The Heisenberg dynamics

-/

/-- The Heisenberg dynamics `α_t(A) = e^{itH} A e^{-itH}` of a self-adjoint element `H`. -/
def evolution (H : selfAdjoint 𝔄) (t : ℝ) : 𝔄 ≃⋆ₐ[ℂ] 𝔄 :=
  Unitary.conjStarAlgAut ℂ 𝔄 (propagator H t)

lemma evolution_apply (H : selfAdjoint 𝔄) (t : ℝ) (a : 𝔄) :
    evolution H t a = propagator H t * a * propagator H (-t) := by
  rw [evolution, Unitary.conjStarAlgAut_apply, ← star_propagator, Unitary.coe_star]

lemma evolution_zero (H : selfAdjoint 𝔄) (a : 𝔄) : evolution H 0 a = a := by
  simp [evolution_apply, propagator_zero]

lemma evolution_add (H : selfAdjoint 𝔄) (s t : ℝ) (a : 𝔄) :
    evolution H (s + t) a = evolution H s (evolution H t a) := by
  simp only [evolution_apply, neg_add_rev, propagator_add, Submonoid.coe_mul, mul_assoc]

/-- The dynamics is isometric. -/
lemma norm_evolution (H : selfAdjoint 𝔄) (t : ℝ) (a : 𝔄) : ‖evolution H t a‖ = ‖a‖ :=
  StarAlgEquiv.norm_map _ a

lemma evolution_self (H : selfAdjoint 𝔄) (t : ℝ) : evolution H t (H : 𝔄) = H := by
  rw [evolution_apply, ← (commute_propagator H t).eq, mul_assoc, ← Submonoid.coe_mul,
    ← propagator_add, add_neg_cancel, propagator_zero, OneMemClass.coe_one, mul_one]

/-!

## C. The Heisenberg equation

-/

lemma hasDerivAt_propagator (H : selfAdjoint 𝔄) (t : ℝ) :
    HasDerivAt (fun s : ℝ => (propagator H s : 𝔄)) ((propagator H t : 𝔄) * (I • (H : 𝔄))) t := by
  have h := hasDerivAt_exp_smul_const (𝕂 := ℝ) (I • (H : 𝔄)) t
  have hfun : (fun s : ℝ => (propagator H s : 𝔄)) = fun s : ℝ => exp (s • (I • (H : 𝔄))) :=
    funext fun s => by rw [propagator_coe, Complex.coe_smul]
  rw [hfun, propagator_coe, Complex.coe_smul]
  exact h

lemma hasDerivAt_propagator_neg (H : selfAdjoint 𝔄) (t : ℝ) :
    HasDerivAt (fun s : ℝ => (propagator H (-s) : 𝔄))
      (-((I • (H : 𝔄)) * (propagator H (-t) : 𝔄))) t := by
  have hc : (propagator H (-t) : 𝔄) * (I • (H : 𝔄)) = (I • (H : 𝔄)) * propagator H (-t) :=
    ((commute_propagator H (-t)).smul_left I).eq.symm
  rw [← hc]
  simpa [Function.comp_def] using (hasDerivAt_propagator H (-t)).scomp t (hasDerivAt_neg t)

/-- The Heisenberg equation for a time dependent observable:
`d/dt α_t(A(t)) = α_t(i[H, A(t)] + A'(t))`. -/
lemma hasDerivAt_evolution_comp (H : selfAdjoint 𝔄) {g : ℝ → 𝔄} {g' : 𝔄} {t : ℝ}
    (hg : HasDerivAt g g' t) :
    HasDerivAt (fun s => evolution H s (g s))
      (evolution H t (I • ((H : 𝔄) * g t - g t * H) + g')) t := by
  have h := ((hasDerivAt_propagator H t).mul hg).mul (hasDerivAt_propagator_neg H t)
  simp only [evolution_apply]
  convert h using 1
  simp only [sub_eq_add_neg, add_mul, mul_add, neg_mul, mul_neg, smul_mul_assoc, mul_smul_comm,
    mul_assoc, smul_add, smul_neg, add_assoc, Pi.mul_apply]
  abel

/-- The Heisenberg equation `d/dt α_t(A) = α_t(i[H, A])`. -/
lemma hasDerivAt_evolution (H : selfAdjoint 𝔄) (a : 𝔄) (t : ℝ) :
    HasDerivAt (fun s => evolution H s a) (evolution H t (I • ((H : 𝔄) * a - a * H))) t := by
  simpa using hasDerivAt_evolution_comp H (hasDerivAt_const t a)

lemma continuous_evolution (H : selfAdjoint 𝔄) (a : 𝔄) : Continuous fun t => evolution H t a :=
  continuous_iff_continuousAt.2 fun t => (hasDerivAt_evolution H a t).continuousAt

/-!

## D. Invariant subalgebras and symmetries

-/

/-- A closed star subalgebra containing `H` is invariant under the dynamics. -/
lemma evolution_mem (H : selfAdjoint 𝔄) (t : ℝ) {S : StarSubalgebra ℂ 𝔄}
    (hS : IsClosed (S : Set 𝔄)) (hH : (H : 𝔄) ∈ S) {a : 𝔄} (ha : a ∈ S) :
    evolution H t a ∈ S := by
  let : Algebra ℚ 𝔄 := (NormedAlgebra.restrictScalars ℚ ℂ 𝔄).toAlgebra
  have hU : ∀ s : ℝ, (propagator H s : 𝔄) ∈ S := fun s => by
    rw [propagator_coe]
    exact exp_mem (R := ℂ) hS (S.smul_mem (S.smul_mem hH I) _)
  rw [evolution_apply]
  exact S.mul_mem (S.mul_mem (hU t) ha) (hU (-t))

/-- A `⋆`-automorphism fixing `H` fixes the propagator. -/
lemma map_propagator (H : selfAdjoint 𝔄) (θ : 𝔄 ≃⋆ₐ[ℂ] 𝔄) (hθ : θ (H : 𝔄) = H) (t : ℝ) :
    θ (propagator H t : 𝔄) = propagator H t := by
  let : NormedAlgebra ℚ 𝔄 := NormedAlgebra.restrictScalars ℚ ℂ 𝔄
  rw [propagator_coe, map_exp θ (StarAlgEquiv.isometry θ).continuous, map_smul, map_smul, hθ]

/-- A `⋆`-automorphism fixing `H` commutes with the dynamics. -/
lemma map_evolution (H : selfAdjoint 𝔄) (θ : 𝔄 ≃⋆ₐ[ℂ] 𝔄) (hθ : θ (H : 𝔄) = H) (t : ℝ)
    (a : 𝔄) : θ (evolution H t a) = evolution H t (θ a) := by
  rw [evolution_apply, evolution_apply, map_mul, map_mul, map_propagator H θ hθ,
    map_propagator H θ hθ]

/-!

## E. Inverse, time reversal and commuting Hamiltonians

-/

lemma evolution_neg_evolution (H : selfAdjoint 𝔄) (t : ℝ) (a : 𝔄) :
    evolution H (-t) (evolution H t a) = a := by
  rw [← evolution_add, neg_add_cancel, evolution_zero]

lemma evolution_evolution_neg (H : selfAdjoint 𝔄) (t : ℝ) (a : 𝔄) :
    evolution H t (evolution H (-t) a) = a := by
  rw [← evolution_add, add_neg_cancel, evolution_zero]

lemma propagator_neg_hamiltonian (H : selfAdjoint 𝔄) (t : ℝ) :
    propagator (-H) t = propagator H (-t) := by
  rw [propagator, propagator, smul_neg, neg_smul]

/-- Reversing the sign of the Hamiltonian reverses time. -/
lemma evolution_neg_hamiltonian (H : selfAdjoint 𝔄) (t : ℝ) (a : 𝔄) :
    evolution (-H) t a = evolution H (-t) a := by
  rw [evolution_apply, evolution_apply, propagator_neg_hamiltonian, propagator_neg_hamiltonian]

lemma propagator_add_of_commute (H K : selfAdjoint 𝔄) (h : Commute (H : 𝔄) K) (t : ℝ) :
    propagator (H + K) t = propagator H t * propagator K t := by
  rw [propagator, smul_add]
  refine Commute.expUnitary_add ?_
  simp only [selfAdjoint.val_smul]
  exact (h.smul_left t).smul_right t

lemma commute_propagator_of_commute (H : selfAdjoint 𝔄) {a : 𝔄} (h : Commute (H : 𝔄) a)
    (t : ℝ) : Commute (propagator H t : 𝔄) a := by
  rw [propagator_coe]
  exact ((h.smul_left I).smul_left (t : ℂ)).exp_left

/-- A Hamiltonian term `K` commuting with `H` and with `A` does not change the dynamics of
`A`. -/
lemma evolution_add_of_commute (H K : selfAdjoint 𝔄) (hHK : Commute (H : 𝔄) K) {a : 𝔄}
    (hK : Commute (K : 𝔄) a) (t : ℝ) : evolution (H + K) t a = evolution H t a := by
  have c1 := commute_propagator_of_commute K hK t
  have c2 := commute_propagator_of_commute K
    (commute_propagator_of_commute H hHK (-t)).symm t
  have hK1 : (propagator K t : 𝔄) * propagator K (-t) = 1 := by
    rw [← Submonoid.coe_mul, ← propagator_add, add_neg_cancel, propagator_zero,
      OneMemClass.coe_one]
  rw [evolution_apply, evolution_apply, propagator_add_of_commute H K hHK,
    propagator_add_of_commute H K hHK, Submonoid.coe_mul, Submonoid.coe_mul]
  calc (propagator H t : 𝔄) * propagator K t * a * (propagator H (-t) * propagator K (-t))
      = propagator H t * a * propagator H (-t) * (propagator K t * propagator K (-t)) := by
        rw [mul_assoc (propagator H t : 𝔄), c1.eq]
        simp only [mul_assoc]
        rw [← mul_assoc (propagator K t : 𝔄) (propagator H (-t) : 𝔄), c2.eq, mul_assoc]
    _ = _ := by rw [hK1, mul_one]

end LatticeFermions
