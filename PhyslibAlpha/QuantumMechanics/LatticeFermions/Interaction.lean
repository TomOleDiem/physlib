module

public import PhyslibAlpha.QuantumMechanics.LatticeFermions.FiniteDynamics
public import Mathlib.Algebra.Star.BigOperators

/-!

# Interactions of graded local nets

Even self-adjoint interaction terms `Φ(X) ∈ 𝔄_X` and on-site terms `D_x ∈ 𝔄_{x}`, and the
Hamiltonians `H_Λ = Σ_{x ∈ Λ} D_x + Σ_{X ⊆ Λ} Φ(X)` of the finite regions.

## i. Overview

An *interaction* of a graded local net assigns to every finite region `X` an even self-adjoint
element `Φ(X)` of the local algebra `𝔄_X`, and to every site `x` an even self-adjoint *on-site
term* `D_x ∈ 𝔄_{x}`. The on-site terms are kept apart: no bound on them is ever used, so chemical
potentials and on-site Hubbard interactions may grow without bound along the lattice. The
interaction terms are controlled by a constant `J` with

`Σ_{X ∋ x} |X| ‖Φ(X)‖ ≤ J` for every site `x`,

stated with finite partial sums, and by *local finiteness*: only finitely many `X ∋ x` have
`Φ(X) ≠ 0`.

The Hamiltonian of a finite region `Λ` is `H_Λ = Σ_{x ∈ Λ} D_x + Σ_{X ⊆ Λ} Φ(X)`, an even
self-adjoint element of `𝔄_Λ`. For a subregion `X ⊆ Λ` it splits as

`H_Λ = D_X + K_X + R`, `D_X = Σ_{x ∈ X} D_x`, `K_X = Σ_{Z ⊆ Λ, Z ∩ X ≠ ∅} Φ(Z)`,

where every term of `R` is even and supported away from `X`, so `R` commutes with `𝔄_X`. Hence the
dynamics generated by `H_Λ - K_X` maps `𝔄_X` into itself: on `𝔄_X` it is the dynamics of the
on-site terms `D_X`. This is the step of the Lieb–Robinson bound where the on-site terms are
absorbed (interaction picture), so that they do not enter the Lieb–Robinson velocity.

## ii. Key results

- `LatticeFermions.Interaction` : interaction terms and on-site terms of a graded local net.
- `LatticeFermions.Interaction.hamiltonian` : the Hamiltonian `H_Λ` of a finite region.
- `LatticeFermions.Interaction.interactionAt` : the interaction terms `K_X` meeting a region.
- `LatticeFermions.Interaction.evolution_sub_interactionAt_mem` : the dynamics of `H_Λ - K_X`
  preserves `𝔄_X`.
- `LatticeFermions.Interaction.IsBoundedBy` : the bound `Σ_{X ∋ x} |X| ‖Φ(X)‖ ≤ J`.
- `LatticeFermions.Interaction.LocallyFinite` : finitely many nonzero terms contain a site.

## iii. Table of contents

- A. Interactions
- B. Commutation with even elements away from a region
- C. Hamiltonians
- D. Splitting off the terms meeting a region
- E. Bounds
- F. Reversing the sign

## iv. References

* B. Nachtergaele, R. Sims, A. Young, Lieb-Robinson bounds, the spectral flow, and stability of
  the spectral gap for lattice fermion systems, arXiv:1705.08553, Section 3.
* O. Bratteli, D. W. Robinson, Operator Algebras and Quantum Statistical Mechanics 2,
  Section 6.2.1.

-/

@[expose] public section

noncomputable section

namespace LatticeFermions

open Finset

variable {V : Type*} [DecidableEq V] {𝔄 : Type*} [CStarAlgebra 𝔄]

/-!

## A. Interactions

-/

/-- An interaction of a graded local net: even self-adjoint terms `Φ(X) ∈ 𝔄_X` for the finite
regions and even self-adjoint on-site terms `D_x ∈ 𝔄_{x}`. -/
structure Interaction (N : GradedLocalNet V 𝔄) where
  /-- The interaction term `Φ(X)` of a finite region. -/
  term : Finset V → 𝔄
  term_mem : ∀ X, term X ∈ N.loc X
  isSelfAdjoint_term : ∀ X, IsSelfAdjoint (term X)
  isEven_term : ∀ X, N.IsEven (term X)
  /-- The on-site term `D_x` of a site. -/
  onSite : V → 𝔄
  onSite_mem : ∀ x, onSite x ∈ N.loc {x}
  isSelfAdjoint_onSite : ∀ x, IsSelfAdjoint (onSite x)
  isEven_onSite : ∀ x, N.IsEven (onSite x)

namespace Interaction

variable {N : GradedLocalNet V 𝔄} (Φ : Interaction N)

/-- The subregions of `Λ` meeting the region `X`. -/
def touching (Λ X : Finset V) : Finset (Finset V) := Λ.powerset.filter fun Z => ¬Disjoint Z X

lemma mem_touching {Λ X Z : Finset V} : Z ∈ touching Λ X ↔ Z ⊆ Λ ∧ ¬Disjoint Z X := by
  simp [touching]

lemma touching_mono {Λ Λ' : Finset V} (h : Λ ⊆ Λ') (X : Finset V) :
    touching Λ X ⊆ touching Λ' X := fun _ hZ => by
  rw [mem_touching] at hZ ⊢; exact ⟨hZ.1.trans h, hZ.2⟩

/-!

## B. Commutation with even elements away from a region

-/

omit [DecidableEq V] in
/-- A finite sum of even elements of local algebras of regions disjoint from `X` commutes with
`𝔄_X`. -/
lemma commute_sum_of_disjoint {X : Finset V} {a : 𝔄} (ha : a ∈ N.loc X) {ι : Type*}
    (s : Finset ι) (f : ι → 𝔄) (Y : ι → Finset V) (hY : ∀ i ∈ s, Disjoint X (Y i))
    (hf : ∀ i ∈ s, f i ∈ N.loc (Y i)) (he : ∀ i ∈ s, N.IsEven (f i)) :
    Commute a (∑ i ∈ s, f i) :=
  Commute.sum_right _ _ _ fun i hi => N.commute_of_disjoint (hY i hi) ha (hf i hi) (he i hi)

/-!

## C. Hamiltonians

-/

/-- The sum `D_X = Σ_{x ∈ X} D_x` of the on-site terms of a region. -/
def onSiteSum (X : Finset V) : 𝔄 := ∑ x ∈ X, Φ.onSite x

omit [DecidableEq V] in
lemma onSite_mem_of_mem {X : Finset V} {x : V} (hx : x ∈ X) : Φ.onSite x ∈ N.loc X :=
  N.loc_mono (singleton_subset_iff.mpr hx) (Φ.onSite_mem x)

omit [DecidableEq V] in
lemma onSiteSum_mem (X : Finset V) : Φ.onSiteSum X ∈ N.loc X :=
  Subalgebra.sum_mem (N.loc X).toSubalgebra fun _ hx => Φ.onSite_mem_of_mem hx

omit [DecidableEq V] in
lemma term_mem_of_subset {X Λ : Finset V} (h : X ⊆ Λ) : Φ.term X ∈ N.loc Λ :=
  N.loc_mono h (Φ.term_mem X)

/-- The Hamiltonian `H_Λ = Σ_{x ∈ Λ} D_x + Σ_{X ⊆ Λ} Φ(X)` of a finite region. -/
def hamiltonian (Λ : Finset V) : selfAdjoint 𝔄 :=
  ⟨Φ.onSiteSum Λ + ∑ Z ∈ Λ.powerset, Φ.term Z,
    (isSelfAdjoint_sum _ fun x _ => Φ.isSelfAdjoint_onSite x).add
      (isSelfAdjoint_sum _ fun Z _ => Φ.isSelfAdjoint_term Z)⟩

omit [DecidableEq V] in
lemma hamiltonian_coe (Λ : Finset V) :
    (Φ.hamiltonian Λ : 𝔄) = Φ.onSiteSum Λ + ∑ Z ∈ Λ.powerset, Φ.term Z := rfl

omit [DecidableEq V] in
lemma hamiltonian_mem (Λ : Finset V) : (Φ.hamiltonian Λ : 𝔄) ∈ N.loc Λ :=
  (N.loc Λ).add_mem (Φ.onSiteSum_mem Λ)
    (Subalgebra.sum_mem (N.loc Λ).toSubalgebra fun _ hZ =>
      Φ.term_mem_of_subset (mem_powerset.mp hZ))

omit [DecidableEq V] in
/-- The Hamiltonian is even. -/
lemma isEven_hamiltonian (Λ : Finset V) : N.IsEven (Φ.hamiltonian Λ : 𝔄) := by
  simp only [GradedLocalNet.IsEven, hamiltonian_coe, onSiteSum, map_add, map_sum]
  rw [sum_congr rfl fun x _ => Φ.isEven_onSite x, sum_congr rfl fun Z _ => Φ.isEven_term Z]

/-- The interaction terms `K_X = Σ_{Z ⊆ Λ, Z ∩ X ≠ ∅} Φ(Z)` meeting a region. -/
def interactionAt (Λ X : Finset V) : selfAdjoint 𝔄 :=
  ⟨∑ Z ∈ touching Λ X, Φ.term Z, isSelfAdjoint_sum _ fun Z _ => Φ.isSelfAdjoint_term Z⟩

lemma interactionAt_coe (Λ X : Finset V) :
    (Φ.interactionAt Λ X : 𝔄) = ∑ Z ∈ touching Λ X, Φ.term Z := rfl

/-!

## D. Splitting off the terms meeting a region

-/

/-- The terms of `H_Λ` supported away from `X`. -/
def remainder (Λ X : Finset V) : 𝔄 :=
  ∑ x ∈ Λ \ X, Φ.onSite x + ∑ Z ∈ Λ.powerset.filter fun Z => Disjoint Z X, Φ.term Z

lemma isSelfAdjoint_remainder (Λ X : Finset V) : IsSelfAdjoint (Φ.remainder Λ X) :=
  (isSelfAdjoint_sum _ fun x _ => Φ.isSelfAdjoint_onSite x).add
    (isSelfAdjoint_sum _ fun Z _ => Φ.isSelfAdjoint_term Z)

/-- The terms of `H_Λ` supported away from `X` commute with `𝔄_X`. -/
lemma commute_remainder {Λ X : Finset V} {a : 𝔄} (ha : a ∈ N.loc X) :
    Commute (Φ.remainder Λ X) a := by
  refine (Commute.add_right ?_ ?_).symm
  · exact commute_sum_of_disjoint ha _ _ (fun x => {x})
      (fun x hx => disjoint_singleton_right.mpr (mem_sdiff.mp hx).2)
      (fun x _ => Φ.onSite_mem x) (fun x _ => Φ.isEven_onSite x)
  · exact commute_sum_of_disjoint ha _ _ id (fun Z hZ => (mem_filter.mp hZ).2.symm)
      (fun Z _ => Φ.term_mem Z) (fun Z _ => Φ.isEven_term Z)

/-- `H_Λ - K_X = D_X + R` for `X ⊆ Λ`. -/
lemma hamiltonian_sub_interactionAt {Λ X : Finset V} (hX : X ⊆ Λ) :
    (Φ.hamiltonian Λ : 𝔄) - Φ.interactionAt Λ X = Φ.onSiteSum X + Φ.remainder Λ X := by
  rw [hamiltonian_coe, interactionAt_coe, remainder, onSiteSum, onSiteSum,
    ← sum_sdiff hX (f := Φ.onSite), ← sum_filter_add_sum_filter_not Λ.powerset
      (fun Z => Disjoint Z X)]
  simp only [touching]
  abel

/-- The dynamics of `H_Λ - K_X` maps `𝔄_X` into itself: on `𝔄_X` it is the dynamics of the
on-site terms `D_X`. -/
lemma evolution_sub_interactionAt_mem {Λ X : Finset V} (hX : X ⊆ Λ) (t : ℝ) {a : 𝔄}
    (ha : a ∈ N.loc X) :
    evolution (Φ.hamiltonian Λ - Φ.interactionAt Λ X) t a ∈ N.loc X := by
  let D : selfAdjoint 𝔄 := ⟨Φ.onSiteSum X, isSelfAdjoint_sum _ fun x _ => Φ.isSelfAdjoint_onSite x⟩
  let R : selfAdjoint 𝔄 := ⟨Φ.remainder Λ X, Φ.isSelfAdjoint_remainder Λ X⟩
  have hsplit : Φ.hamiltonian Λ - Φ.interactionAt Λ X = D + R :=
    Subtype.ext (Φ.hamiltonian_sub_interactionAt hX)
  rw [hsplit, evolution_add_of_commute D R (Φ.commute_remainder (Φ.onSiteSum_mem X)).symm
    (Φ.commute_remainder ha)]
  exact evolution_mem D t (N.isClosed_loc X) (Φ.onSiteSum_mem X) ha

/-!

## E. Bounds

-/

/-- The interaction terms are bounded by `J`: `Σ_{X ∋ x} |X| ‖Φ(X)‖ ≤ J` for every site `x`,
stated for all finite partial sums. The on-site terms do not enter. -/
def IsBoundedBy (J : ℝ) : Prop :=
  ∀ (x : V) (Λ : Finset V), ∑ Z ∈ Λ.powerset.filter (x ∈ ·), (#Z : ℝ) * ‖Φ.term Z‖ ≤ J

/-- Local finiteness: only finitely many regions containing a given site carry a nonzero
interaction term. -/
def LocallyFinite : Prop := ∀ x : V, {Z : Finset V | x ∈ Z ∧ Φ.term Z ≠ 0}.Finite

lemma nonneg_of_isBoundedBy [Nonempty V] {J : ℝ} (hJ : Φ.IsBoundedBy J) : 0 ≤ J := by
  have h := hJ (Classical.arbitrary V) ∅
  simpa [filter_singleton] using h

/-!

## F. Reversing the sign

The interaction `-Φ` has the Hamiltonians `-H_Λ`, so its dynamics runs backwards in time. This
reduces statements for negative times to positive times.

-/

/-- The interaction with all terms and on-site terms negated. -/
def neg : Interaction N where
  term X := -Φ.term X
  term_mem X := neg_mem (Φ.term_mem X)
  isSelfAdjoint_term X := (Φ.isSelfAdjoint_term X).neg
  isEven_term X := by
    simp only [GradedLocalNet.IsEven, map_neg]; rw [Φ.isEven_term X]
  onSite x := -Φ.onSite x
  onSite_mem x := neg_mem (Φ.onSite_mem x)
  isSelfAdjoint_onSite x := (Φ.isSelfAdjoint_onSite x).neg
  isEven_onSite x := by
    simp only [GradedLocalNet.IsEven, map_neg]; rw [Φ.isEven_onSite x]

omit [DecidableEq V] in
lemma neg_term (X : Finset V) : Φ.neg.term X = -Φ.term X := rfl

omit [DecidableEq V] in
lemma hamiltonian_neg (Λ : Finset V) : Φ.neg.hamiltonian Λ = -Φ.hamiltonian Λ :=
  Subtype.ext (by simp [hamiltonian_coe, onSiteSum, neg, sum_neg_distrib, add_comm])

omit [DecidableEq V] in
/-- The dynamics of `-Φ` is the dynamics of `Φ` backwards in time. -/
lemma evolution_hamiltonian_neg (Λ : Finset V) (t : ℝ) (a : 𝔄) :
    evolution (Φ.neg.hamiltonian Λ) t a = evolution (Φ.hamiltonian Λ) (-t) a := by
  rw [hamiltonian_neg, evolution_neg_hamiltonian]

lemma IsBoundedBy.neg {J : ℝ} (hJ : Φ.IsBoundedBy J) : Φ.neg.IsBoundedBy J := by
  simpa [IsBoundedBy, neg_term] using hJ

omit [DecidableEq V] in
lemma LocallyFinite.neg (hfin : Φ.LocallyFinite) : Φ.neg.LocallyFinite := by
  simpa [LocallyFinite, neg_term] using hfin

end Interaction

end LatticeFermions
