module

public import PhyslibAlpha.Mathematics.HilbertSpace.TensorPower
public import Mathlib.Analysis.Normed.Operator.Compact.Basic
public import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
/-!

# The observable algebras of the particle sectors

The C*-algebra of observables of `n` identical bosons that are compact on some of the particles.

## i. Overview

The `n`-particle space of a boson with one-particle space `h` is the symmetric subspace
`Sym^n(h)`. An observable that acts only on `m` of the `n` particles is `P_n (K ⊗ 1) P_n` for a
compact operator `K` of `m` particles. The C*-algebra generated by these operators for
`0 ≤ m ≤ n` is the sector algebra `𝔎_n`. It is the algebra of the observables that are
compact on every particle subset except the whole system. The sector algebras form an inverse
system over the particle number. Their bounded inverse limit is the Buchholz algebra of the
infinite system.

## ii. Key results

- `Boson.genSet`: the generators `P_n (K ⊗ 1) P_n` with `K` compact on `m ≤ n` particles.
- `Boson.sectorAlgebra`: the C*-algebra they generate.
- `Boson.gen_mem_sectorAlgebra`: the generators lie in it.

## iii. Table of contents

- A. The sector algebra

## iv. References

* D. Buchholz, The resolvent algebra of non-relativistic Bose fields: observables, dynamics and
  states, Commun. Math. Phys. 362 (2018).
* A. Deuchert, J. Lampart and M. Lemm, Dynamics and equilibrium states of infinite systems of
  lattice bosons, arXiv:2505.13170.
-/

@[expose] public section

universe u

open HilbertPower
open scoped InnerProductSpace

noncomputable section

namespace Boson

variable (h : Type u) [NormedAddCommGroup h] [InnerProductSpace ℂ h] [CompleteSpace h]

/-!

## A. The sector algebra

-/

instance (n : ℕ) : IsTopologicalRing (sym h n →L[ℂ] sym h n) := by
  letI : CStarAlgebra (sym h n →L[ℂ] sym h n) := inferInstance
  exact inferInstance

instance (n : ℕ) : ContinuousStar (sym h n →L[ℂ] sym h n) := by
  letI : CStarAlgebra (sym h n →L[ℂ] sym h n) := inferInstance
  exact inferInstance

/-- The generators of the `n`-particle sector algebra: the operators `P_n (K ⊗ 1^{⊗k}) P_n` with
`K` compact on the symmetric subspace of `m` particles and `m + k = n`. -/
def genSet (n : ℕ) : Set (sym h n →L[ℂ] sym h n) :=
  {A | ∃ (m k : ℕ) (e : m + k = n) (K : sym h m →L[ℂ] sym h m),
    IsCompactOperator K ∧ IsCompactOperator (ContinuousLinearMap.adjoint K) ∧ A = e ▸ gen K k}

/-- The sector algebra `𝔎_n`: the C*-algebra generated by operators that are compact on some
particles and the identity on the others. -/
def sectorAlgebra (n : ℕ) : StarSubalgebra ℂ (sym h n →L[ℂ] sym h n) :=
  (StarAlgebra.adjoin ℂ (genSet h n)).topologicalClosure

lemma gen_mem_sectorAlgebra {m k : ℕ} {K : sym h m →L[ℂ] sym h m} (hK : IsCompactOperator K)
    (hK' : IsCompactOperator (ContinuousLinearMap.adjoint K)) :
    gen K k ∈ sectorAlgebra h (m + k) :=
  have h₀ : gen K k ∈ genSet h (m + k) := ⟨m, k, rfl, K, hK, hK', rfl⟩
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ h₀)

lemma isClosed_sectorAlgebra (n : ℕ) : IsClosed (sectorAlgebra h n : Set (sym h n →L[ℂ] sym h n)) :=
  isClosed_closure

instance (n : ℕ) : CompleteSpace (sectorAlgebra h n) :=
  (isClosed_sectorAlgebra h n).completeSpace_coe

/-- **The sector algebra is a C*-algebra.** -/
noncomputable instance (n : ℕ) : CStarAlgebra (sectorAlgebra h n) :=
  letI : CStarAlgebra (sym h n →L[ℂ] sym h n) := inferInstance
  { }

/-!

## B. Unitary covariance

-/

/-- A linear isometric equivalence of the one-particle space as a bounded operator. -/
abbrev opOf (U : h ≃ₗᵢ[ℂ] h) : h →L[ℂ] h := U.toContinuousLinearEquiv.toContinuousLinearMap

lemma adjoint_opOf (U : h ≃ₗᵢ[ℂ] h) : ContinuousLinearMap.adjoint (opOf h U) = opOf h U.symm := by
  symm
  rw [ContinuousLinearMap.eq_adjoint_iff]
  intro x y
  show ⟪U.symm x, y⟫_ℂ = ⟪x, U y⟫_ℂ
  rw [← U.inner_map_map, U.apply_symm_apply]

/-- **A one-particle unitary acts as a unitary on every symmetric particle sector.** -/
def symUnitary (U : h ≃ₗᵢ[ℂ] h) (n : ℕ) : unitary (sym h n →L[ℂ] sym h n) :=
  ⟨symAct (opOf h U) n, by
    rw [Unitary.mem_iff, ContinuousLinearMap.star_eq_adjoint, adjoint_symAct, adjoint_opOf]
    constructor
    · rw [ContinuousLinearMap.mul_def, ← symAct_comp]
      have : opOf h U.symm ∘L opOf h U = ContinuousLinearMap.id ℂ h := by
        ext x; exact U.symm_apply_apply x
      rw [this, symAct_id]; rfl
    · rw [ContinuousLinearMap.mul_def, ← symAct_comp]
      have : opOf h U ∘L opOf h U.symm = ContinuousLinearMap.id ℂ h := by
        ext x; exact U.apply_symm_apply x
      rw [this, symAct_id]; rfl⟩

/-- Conjugation by a one-particle unitary maps compact operators to compact operators. -/
lemma isCompact_conj {m : ℕ} (W : unitary (sym h m →L[ℂ] sym h m)) {K : sym h m →L[ℂ] sym h m}
    (hK : IsCompactOperator K) : IsCompactOperator ((W : sym h m →L[ℂ] sym h m) * K * star (W : sym h m →L[ℂ] sym h m)) := by
  have h1 : IsCompactOperator ((W : sym h m →L[ℂ] sym h m) * K) :=
    IsCompactOperator.clm_comp hK _
  exact IsCompactOperator.comp_clm h1 _

lemma isCompact_conj_adjoint {m : ℕ} (W : unitary (sym h m →L[ℂ] sym h m))
    {K : sym h m →L[ℂ] sym h m} (hK : IsCompactOperator (ContinuousLinearMap.adjoint K)) :
    IsCompactOperator (ContinuousLinearMap.adjoint ((W : sym h m →L[ℂ] sym h m) * K *
      star (W : sym h m →L[ℂ] sym h m))) := by
  have e : ContinuousLinearMap.adjoint ((W : sym h m →L[ℂ] sym h m) * K *
      star (W : sym h m →L[ℂ] sym h m)) = (W : sym h m →L[ℂ] sym h m) *
        ContinuousLinearMap.adjoint K * star (W : sym h m →L[ℂ] sym h m) := by
    simp only [ContinuousLinearMap.mul_def, ContinuousLinearMap.star_eq_adjoint,
      ContinuousLinearMap.adjoint_comp, ContinuousLinearMap.adjoint_adjoint,
      ContinuousLinearMap.comp_assoc]
  rw [e]
  exact isCompact_conj h W hK

/-- **Covariance of the generators**: conjugating `gen K k` by the unitary of a one-particle
unitary gives the generator of the conjugated compact operator. -/
lemma conj_gen (U : h ≃ₗᵢ[ℂ] h) {m : ℕ} (K : sym h m →L[ℂ] sym h m) (k : ℕ) :
    (symUnitary h U (m + k) : sym h (m + k) →L[ℂ] sym h (m + k)) * gen K k *
        star (symUnitary h U (m + k) : sym h (m + k) →L[ℂ] sym h (m + k)) =
      gen ((symUnitary h U m : sym h m →L[ℂ] sym h m) * K *
        star (symUnitary h U m : sym h m →L[ℂ] sym h m)) k := by
  set Wm : sym h m →L[ℂ] sym h m := (symUnitary h U m : sym h m →L[ℂ] sym h m) with hWm
  set Wn : sym h (m + k) →L[ℂ] sym h (m + k) :=
    (symUnitary h U (m + k) : sym h (m + k) →L[ℂ] sym h (m + k)) with hWn
  have hm : star Wm * Wm = 1 := Unitary.coe_star_mul_self (symUnitary h U m)
  have hn : Wn * star Wn = 1 := Unitary.coe_mul_star_self (symUnitary h U (m + k))
  have hK : symAct (opOf h U) m ∘L K = (Wm * K * star Wm) ∘L symAct (opOf h U) m := by
    change Wm * K = (Wm * K * star Wm) * Wm
    rw [mul_assoc (Wm * K), hm, mul_one]
  have h1 := symAct_gen (opOf h U) K _ hK k
  change Wn * gen K k = gen (Wm * K * star Wm) k * Wn at h1
  rw [h1, mul_assoc, hn, mul_one]

/-- **The one-particle unitaries preserve the sector algebra.** Conjugation of `𝔎_n` by the unitary
of a one-particle unitary stays in `𝔎_n`. -/
lemma conj_mem_sectorAlgebra (U : h ≃ₗᵢ[ℂ] h) (n : ℕ) {X : sym h n →L[ℂ] sym h n}
    (hX : X ∈ sectorAlgebra h n) :
    (symUnitary h U n : sym h n →L[ℂ] sym h n) * X *
      star (symUnitary h U n : sym h n →L[ℂ] sym h n) ∈ sectorAlgebra h n := by
  letI : CStarAlgebra (sym h n →L[ℂ] sym h n) := inferInstance
  let f := Unitary.conjStarAlgAut ℂ (sym h n →L[ℂ] sym h n) (symUnitary h U n)
  have hf : ∀ Y, f Y = (symUnitary h U n : sym h n →L[ℂ] sym h n) * Y *
      star (symUnitary h U n : sym h n →L[ℂ] sym h n) := fun Y =>
    Unitary.conjStarAlgAut_apply (symUnitary h U n) Y
  let S : StarSubalgebra ℂ (sym h n →L[ℂ] sym h n) :=
    (sectorAlgebra h n).comap f.toStarAlgHom
  have hS : IsClosed (S : Set (sym h n →L[ℂ] sym h n)) := by
    have hc : Continuous f := by
      show Continuous fun Y => (symUnitary h U n : sym h n →L[ℂ] sym h n) * Y *
        star (symUnitary h U n : sym h n →L[ℂ] sym h n)
      fun_prop
    exact (isClosed_sectorAlgebra h n).preimage hc
  have hgen : genSet h n ⊆ S := by
    rintro _ ⟨m, k, e, K, hK, hK', rfl⟩
    subst e
    show f (gen K k) ∈ sectorAlgebra h (m + k)
    rw [hf, conj_gen]
    exact gen_mem_sectorAlgebra h (isCompact_conj h (symUnitary h U m) hK)
      (isCompact_conj_adjoint h (symUnitary h U m) hK')
  have : sectorAlgebra h n ≤ S :=
    StarSubalgebra.topologicalClosure_minimal (StarAlgebra.adjoin_le hgen) hS
  have hmem := this hX
  exact hmem

lemma symUnitary_symm (U : h ≃ₗᵢ[ℂ] h) (n : ℕ) :
    symUnitary h U.symm n = star (symUnitary h U n) := by
  apply Subtype.ext
  show symAct (opOf h U.symm) n = ContinuousLinearMap.adjoint (symAct (opOf h U) n)
  rw [adjoint_symAct, adjoint_opOf]

/-- The star homomorphism of the sector algebra given by conjugation with a one-particle
unitary. -/
def sectorHom (U : h ≃ₗᵢ[ℂ] h) (n : ℕ) : sectorAlgebra h n →⋆ₐ[ℂ] sectorAlgebra h n :=
  letI : CStarAlgebra (sym h n →L[ℂ] sym h n) := inferInstance
  { toFun := fun X => ⟨(symUnitary h U n : sym h n →L[ℂ] sym h n) * X *
      star (symUnitary h U n : sym h n →L[ℂ] sym h n), conj_mem_sectorAlgebra h U n X.2⟩
    map_one' := Subtype.ext (map_one (Unitary.conjStarAlgAut ℂ (sym h n →L[ℂ] sym h n)
      (symUnitary h U n)))
    map_mul' := fun X Y => Subtype.ext (map_mul (Unitary.conjStarAlgAut ℂ
      (sym h n →L[ℂ] sym h n) (symUnitary h U n)) (X : sym h n →L[ℂ] sym h n) Y)
    map_zero' := Subtype.ext (map_zero (Unitary.conjStarAlgAut ℂ (sym h n →L[ℂ] sym h n)
      (symUnitary h U n)))
    map_add' := fun X Y => Subtype.ext (map_add (Unitary.conjStarAlgAut ℂ
      (sym h n →L[ℂ] sym h n) (symUnitary h U n)) (X : sym h n →L[ℂ] sym h n) Y)
    commutes' := fun r => Subtype.ext (AlgHomClass.commutes (Unitary.conjStarAlgAut ℂ
      (sym h n →L[ℂ] sym h n) (symUnitary h U n)) r)
    map_star' := fun X => Subtype.ext (map_star (Unitary.conjStarAlgAut ℂ
      (sym h n →L[ℂ] sym h n) (symUnitary h U n)) (X : sym h n →L[ℂ] sym h n)) }

lemma sectorHom_apply (U : h ≃ₗᵢ[ℂ] h) (n : ℕ) (X : sectorAlgebra h n) :
    (sectorHom h U n X : sym h n →L[ℂ] sym h n) =
      (symUnitary h U n : sym h n →L[ℂ] sym h n) * X *
        star (symUnitary h U n : sym h n →L[ℂ] sym h n) := rfl

/-- **The sector algebra automorphism of a one-particle unitary.** -/
def sectorEquiv (U : h ≃ₗᵢ[ℂ] h) (n : ℕ) : sectorAlgebra h n ≃⋆ₐ[ℂ] sectorAlgebra h n :=
  StarAlgEquiv.ofStarAlgHom (sectorHom h U n) (sectorHom h U.symm n)
    (by
      refine StarAlgHom.ext fun X => Subtype.ext ?_
      rw [StarAlgHom.comp_apply, sectorHom_apply, sectorHom_apply, symUnitary_symm]
      have hw1 : (symUnitary h U n : sym h n →L[ℂ] sym h n) *
          star (symUnitary h U n : sym h n →L[ℂ] sym h n) = 1 :=
        Unitary.coe_mul_star_self _
      have hw2 : star (symUnitary h U n : sym h n →L[ℂ] sym h n) *
          (symUnitary h U n : sym h n →L[ℂ] sym h n) = 1 := Unitary.coe_star_mul_self _
      simp only [Unitary.coe_star, star_star]
      calc _ = (star (symUnitary h U n : sym h n →L[ℂ] sym h n) *
              (symUnitary h U n : sym h n →L[ℂ] sym h n)) * (X : sym h n →L[ℂ] sym h n) *
            (star (symUnitary h U n : sym h n →L[ℂ] sym h n) *
              (symUnitary h U n : sym h n →L[ℂ] sym h n)) := by
            simp only [mul_assoc]
        _ = _ := by rw [hw2]; simp)
    (by
      refine StarAlgHom.ext fun X => Subtype.ext ?_
      rw [StarAlgHom.comp_apply, sectorHom_apply, sectorHom_apply, symUnitary_symm]
      have hw1 : (symUnitary h U n : sym h n →L[ℂ] sym h n) *
          star (symUnitary h U n : sym h n →L[ℂ] sym h n) = 1 :=
        Unitary.coe_mul_star_self _
      have hw2 : star (symUnitary h U n : sym h n →L[ℂ] sym h n) *
          (symUnitary h U n : sym h n →L[ℂ] sym h n) = 1 := Unitary.coe_star_mul_self _
      simp only [Unitary.coe_star, star_star]
      calc _ = ((symUnitary h U n : sym h n →L[ℂ] sym h n) *
              star (symUnitary h U n : sym h n →L[ℂ] sym h n)) * (X : sym h n →L[ℂ] sym h n) *
            ((symUnitary h U n : sym h n →L[ℂ] sym h n) *
              star (symUnitary h U n : sym h n →L[ℂ] sym h n)) := by
            simp only [mul_assoc]
        _ = _ := by rw [hw1]; simp)

lemma symUnitary_trans (U V : h ≃ₗᵢ[ℂ] h) (n : ℕ) :
    (symUnitary h (U.trans V) n : sym h n →L[ℂ] sym h n) =
      (symUnitary h V n : sym h n →L[ℂ] sym h n) * (symUnitary h U n : sym h n →L[ℂ] sym h n) := by
  show symAct (opOf h (U.trans V)) n = symAct (opOf h V) n * symAct (opOf h U) n
  rw [ContinuousLinearMap.mul_def, ← symAct_comp]
  rfl

/-- **Group law of the sector automorphisms**: `α_{V ∘ U} = α_V ∘ α_U`. -/
lemma sectorHom_trans (U V : h ≃ₗᵢ[ℂ] h) (n : ℕ) :
    sectorHom h (U.trans V) n = (sectorHom h V n).comp (sectorHom h U n) := by
  refine StarAlgHom.ext fun X => Subtype.ext ?_
  rw [sectorHom_apply, StarAlgHom.comp_apply, sectorHom_apply, sectorHom_apply,
    symUnitary_trans]
  simp only [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.mul_def,
    ContinuousLinearMap.adjoint_comp, ContinuousLinearMap.comp_assoc]

end Boson
